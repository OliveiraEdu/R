doi = {10.1145/3708035.3736029},
abstract = {The Nebraska Research Data Storage (NRDStor) service, provided by the University of Nebraska, aims to simplify and accelerate researchers’ access to computing resources, including campus computing clusters. Researchers can access NRDStor through two convenient methods: directly through the file system mounted on compute worker nodes or utilizing the SMB protocol from any campus-networked computer. Furthermore, NRDStor enhances the ease of sharing research data and results through integration with the Open Science Data Federation (OSDF) and Globus.},
booktitle = {Practice and Experience in Advanced Research Computing 2025: The Power of Collaboration},
articleno = {105},
numpages = {3},
keywords = {Storage, Filesystem, HPC, SMB, Dashboard, CEPH},
location = {
},
series = {PEARC '25}
}

@inproceedings{10.1145/3702163.3702429,
author = {Qiu, Vivian Yifei and Tse, Alex Wing Cheung},
title = {Research Trends and Emerging Themes of Data Repository for Research Data Management Services in Higher Education: a Bibliometric Analysis},
year = {2025},
isbn = {9798400717819},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3702163.3702429},
doi = {10.1145/3702163.3702429},
abstract = {Research data management (RDM) has become an important service for research support in higher education. Data repository is a prevailing and emerging tool in implementing RDM services. This study performed a bibliometric analysis on literature related to data repository for research data management services, using the bibliometric visualization tool of VOS Viewer to reveal the research trends and emerging themes of this area. The bibliometric data was identified and exported from the Web of Science Core Collection database, comprising 199 journal articles published from 2013 to 2023. This study covers two parts of analysis: firstly, by analyzing the keyword clusters and keyword frequency, leading research trends of data repository for RDM services were identified with the analysis of each cluster. Secondly, the yearly distribution of keywords with the evolution over time was analyzed to determine the emerging themes. The results identified four research trends of data repository for RDM services: 1) library as a key role of the data repository services provider; 2) Findability, Accessibility, Interoperability, and Reusability (FAIR) principles; 3) open data &amp; data sharing; and 4) disciplinary data repository; and two emerging themes: 1) data repository services in the medical discipline; and 2) the publicity and visibility of data repository by the registry. Based on the “FAIR” which is the core principle of this field, this study summarized the framework for the reasons and requirements of data repository for research data management services.},
booktitle = {Proceedings of the 2024 16th International Conference on Education Technology and Computers},
pages = {295–303},
numpages = {9},
keywords = {Bibliometric analysis, Data repository, Information technology in higher education, Research data management, Research support services},
location = {
},
series = {ICETC '24}
}

