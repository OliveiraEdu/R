@inproceedings{10.1145/3671151.3671368,
author = {Dai, Jie},
title = {Research on Cloud Storage Database Integrity Detection based on Intelligent Verification},
year = {2024},
isbn = {9798400718106},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3671151.3671368},
doi = {10.1145/3671151.3671368},
abstract = {With the rapid development of cloud computing, the security and integrity of data verification process has become an important issue, especially in the cloud storage environment. However, existing verification process requires users to verify the data and will cost unacceptable computation costs. Based on intelligent algorithms, this work proposes a novel integrity detection method for cloud storage databases. Initially, we design a data integrity verification framework based on hash functions and digital signatures. By creating a secure hash index in the cloud, users can effectively verify stored data without having to download the entire file. Subsequently, a machine learning model is involved to automatically predict potential data tampering behavior, thereby reducing unnecessary integrity verification operations and improving the overall efficiency of the system. From our extensive simulation results, we can observe that our proposed model can achieve the verification with reasonable computation resources and acceptable accuracy.},
booktitle = {Proceedings of the 5th International Conference on Computer Information and Big Data Applications},
pages = {1242–1246},
numpages = {5},
location = {Wuhan, China},
series = {CIBDA '24}
}

@inproceedings{10.1145/3663741.3664792,
author = {Bellandi, Valerio and Ceravolo, Paolo and Siccardi, Stefano},
title = {Enhancing Semantic Exploration: A Distributed Repository Approach},
year = {2024},
isbn = {9798400706790},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3663741.3664792},
doi = {10.1145/3663741.3664792},
abstract = {In the modern digital era centralized and distributed systems emerge as two prominent paradigms for organizing ICT infrastructure, each presenting distinct advantages and challenges. Centralized systems concentrate resources and processing power in a single location, offering streamlined management and control but introducing risks such as single points of failure. In contrast, distributed systems distribute resources across multiple nodes, enhancing scalability, fault tolerance, and resilience, albeit with increased complexity in management. The choice between centralized and distributed systems hinges on factors like application nature, scalability requirements, and data sensitivity. While centralized systems suit applications with modest scalability needs and centralized control, distributed systems excel in large-scale deployments requiring high availability and performance optimization. This paper presents a real-world application scenario involving a distributed repository of documents and metadata. The application entails a network of edge document repositories analyzing textual content and metadata to extract entities, thereby offering enhanced semantic exploration functionalities for the Italian Ministry of Justice.},
booktitle = {Proceedings of the International Workshop on Big Data in Emergent Distributed Environments},
articleno = {5},
numpages = {5},
keywords = {Data Management, Distributed Architecture, Entities Extraction},
location = {Santiago, AA, Chile},
series = {BiDEDE '24}
}

@inproceedings{10.1145/3555776.3578996,
author = {Bistarelli, Stefano and Bracciali, Andrea and Klomp, Rick and Mercanti, Ivan},
title = {Towards automated verification of Bitcoin-based decentralised applications},
year = {2023},
isbn = {9781450395175},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3555776.3578996},
doi = {10.1145/3555776.3578996},
abstract = {The Bitcoin language SCRIPT has undergone several technically non-trivial updates, still striving from security and minimal risk exposure. Up-to-date, formal verification is of strong interest for script programs that validate the correctness of the Bitcoin decentralised ledger, and allow more and more sophisticated protocols and decentralised applications to be implemented on top of Bitcoin transactions. We propose ScriFy, a comprehensive framework for the verification of the current SCRIPT language: a symbolic semantics and execution model, a model checker, and a modular (dockered), open-source verifier. Given the SCRIPT code that locks a Bitcoin transaction, ScriFy returns the minimal information needed to successfully execute it and authorise the transaction. Distinguishably, ScriFy features both recently added SCRIPT operators and an enhanced analysis, which considers prior information in the ledger. The framework is proved correct and validated through significant examples.},
booktitle = {Proceedings of the 38th ACM/SIGAPP Symposium on Applied Computing},
pages = {262–269},
numpages = {8},
keywords = {trustworthy bitcoin, decentralised protocols, SCRIPT, verification},
location = {Tallinn, Estonia},
series = {SAC '23}
}

@inproceedings{10.1145/3723178.3723260,
author = {Khan, Amir Labib and Hasan, K. M. Azharul},
title = {Event Detection and Trust Verification using Blockchain},
year = {2025},
isbn = {9798400713828},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3723178.3723260},
doi = {10.1145/3723178.3723260},
abstract = {With the fast-paced information sharing across online networks today, there exists an increasing demand for reliable and trustworthy event reporting systems. In this paper, we propose a blockchain-enabled event verification system which tackles the issues of misinformation and distrust in incident reporting. By utilizing the Ethereum blockchain and cryptographic techniques based on ecc, the system allows users to publish emergency events where all posts are signed with private keys to provide authenticity. Public keys allow users to verify the correctness of reported events, which facilitates the verification of posts. Users are rewarded for valid event posts and post verification assuring that active users are encouraged to work while feeding the community. The use of InterPlanetary File System (IPFS) allows us to securely store and retrieve data related to the event, like images and other multimedia. Leveraging the decentralized nature of blockchain technology along with ECC to sign and verify the reports of the events from the community with higher integrity, reliability and transparency leading towards efficient emergency response through trusted system and public safety.},
booktitle = {Proceedings of the 3rd International Conference on Computing Advancements},
pages = {623–628},
numpages = {6},
keywords = {Blockchain, Event Detection, Cryptography, Signature Verification},
location = {
},
series = {ICCA '24}
}

@inproceedings{10.1145/3624062.3624142,
author = {Khuvis, Samuel},
title = {BaRRT: Buildtime and Runtime Reproducibility Tool for Software Development and Testing},
year = {2023},
isbn = {9798400707858},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3624062.3624142},
doi = {10.1145/3624062.3624142},
abstract = {During software development, many aspects of the system and user state can change. Significant time can be spent tracking down the causes of these differences, rather than focusing on the main task of software development. This paper describes a tool to record the state at build-time and at runtime of an application to more easily investigate the cause(s) of differences in behavior. The added logging enables better software quality assurance by tracking code changes and their effects on runtime behavior. At a minimum, this tool only requires prepending one command at build-time and another at runtime. Project-level configurations can be set to enable the collection of additional information.},
booktitle = {Proceedings of the SC '23 Workshops of the International Conference on High Performance Computing, Network, Storage, and Analysis},
pages = {673–676},
numpages = {4},
keywords = {HPC, Reproducibility},
location = {Denver, CO, USA},
series = {SC-W '23}
}

@article{10.1145/3721139,
author = {Hoffmann, Felix},
title = {DFTWS: Deterministic, Fair and Transparent Winner Selection for the Useful Work Blockchain Gophy},
year = {2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3721139},
doi = {10.1145/3721139},
abstract = {This publication presents a novel cryptographic commit scheme named DFTWS which is used to enable deterministic, fair and transparent winner selection in an open-source Proof-of-Useful-Work blockchain for High Energy Physics (HEP) called gophy [9]. In gophy, instead of spamming hashing operations to mine blocks miners are running computationally expensive Monte Carlo simulations to support a real-world HEP experiment with necessary data required to conduct the experiment. To preserve the usefulness property, block problems are defined over time by a Root Authority which is coordinated by a representative of a real-world HEP experiment. In order to be able to provide a transparent mechanism that allows for fair block winner selection from a list of eligible miners that solved a block problem, DFTWS is employed to achieve consensus between nodes. A strength of this approach is that every node is able to verify the fairness of the winner selection process. This publication provides an in-depth description and theoretical fairness analysis of DFTWS, a practical evaluation of its performance under real-world conditions and considerations of potential bottlenecks that can potentially occur as the node network scales. It also discusses a deployment strategy for using DFTWS on top of existing blockchain infrastructure like the Ethereum network. Additionally, theoretical performance aspects of DFTWS are compared with various state-of-the-art cryptographic commitment schemes and Zero Knowledge Proof systems.},
note = {Just Accepted},
journal = {Distrib. Ledger Technol.},
month = feb,
keywords = {cryptographic commitment scheme, zero knowledge proof, blockchain, consensus, proof-of-useful-work, distributed computing}
}

@inproceedings{10.1109/DAC56929.2023.10247718,
author = {Zhou, Yang and Wang, Fang and Shi, Zhan and Feng, Dan and Du, Yu},
title = {Fair Will Go On: A Collaboration-Aware Fairness Scheme for NVMe SSD in Cloud Storage System},
year = {2025},
isbn = {9798350323481},
publisher = {IEEE Press},
url = {https://doi.org/10.1109/DAC56929.2023.10247718},
doi = {10.1109/DAC56929.2023.10247718},
abstract = {Since multiple flows (users) compete for a single, shared solid state drives (SSDs) concurrently in cloud environments, fairness has drawn great interest in recent years. Although many fair schemes are proposed on different modules of SSDs, such as resource allocation for the cache and chip queue reordering for the transaction scheduling unit (TSU), they fail to continue to provide fairness for the worse locality of I/O requests due to a deeper cloud storage stack that makes cache performance poor. Moreover, existing methods only treat back-end flash as a black box and do not exploit the differences in flash features across requests. This paper proposes CoFS, a novel coordinated SSD cache and TSU light-weight learning-based fair scheme to achieve complete fairness considering cache and bandwidth resources which are significant for fairness control. The key idea is to make the front-end SSD cache achieves fairness at the workload-level by recognizing dynamic I/O changes, while the back-end TSU achieves fairness at the flash-level by awareness of flash page-types, and finally CoFS collaborates with them to achieve fairness at the SSD device-level. Experimental results show that CoFS achieves significant fairness and performance gain of a wide range of the latest cloud block storage workloads, with an average improvement of 46.3% and 94.5% compared to state-of-the-art fairness policies, respectively.},
booktitle = {Proceedings of the 60th Annual ACM/IEEE Design Automation Conference},
pages = {1–6},
numpages = {6},
keywords = {NVMe SSD, fairness, collaborative control},
location = {San Francisco, California, United States},
series = {DAC '23}
}

