@inproceedings{10.1109/SCW63240.2024.00110,
author = {Lakshminarayana, Vijeth Kumbarahally and Oguchi, Carolina Minami and Sim, Alex and Wu, Kesheng and Ghosal, Dipak},
title = {A Study of a Deterministic Networking Framework for Latency Critical Large Scientific Data Transfers},
year = {2025},
isbn = {9798350355543},
publisher = {IEEE Press},
url = {https://doi.org/10.1109/SCW63240.2024.00110},
doi = {10.1109/scw63240.2024.00110},
abstract = {Scientific workflows often involve large data transfers, which increasingly require completion-time guarantees. To support these time-sensitive flows, the Energy Science Network (ESnet) has implemented on-demand circuits with packet priority, allowing the circuit to be utilized by other traffic when the deadline-sensitive flow is inactive. In this paper, we explore a deterministic networking framework designed to support large scientific data transfers with completion guarantees. We consider an ideal network where all nodes are time-synchronized and utilize Cyclic Queueing and Forwarding (CQF) to achieve reliable low-latency data transfers. Specifically, the CQF cycle time is configured to ensure that all data transfers between neighboring nodes are completed within the cycle time. The number of packets transferable between two neighboring nodes depends on the cycle time, propagation delay, and link bandwidth. We conduct simulations to compare the performance of the deterministic networking framework with two circuit-based schemes: one utilizing fixed bandwidth allocation for all requests and another employing dynamic bandwidth reservation, which adjusts the allocated bandwidth based on the available bandwidth along the path. Our results show that the deterministic network architecture achieves performance comparable to the dynamic bandwidth reservation scheme. We believe that a more optimized version of the time-sensitive networking protocol, exploiting multi-path routing, could offer better completion guarantees than traditional network reservation options, while enhancing the overall network bandwidth utilization.},
booktitle = {Proceedings of the SC '24 Workshops of the International Conference on High Performance Computing, Network, Storage, and Analysis},
pages = {770–774},
numpages = {5},
keywords = {Bandwidth reservation, Bandwidth-Reserved Circuit-Switched Routing (BRCSR), Cyclic Queueing and Forwarding (CQF), Deterministic networking, Full-Bandwidth Circuit-Switched Routing (FBCSR), Latency guarantees, Scientific data transfers, Time-Sensitive Networking},
location = {Atlanta, GA, USA},
series = {SC-W '24}
}

@inproceedings{10.1145/3702359.3702360,
author = {Hata, Yudai and Sakurai, Kouichi},
title = {Design of Educational Data Management System with Blockchain and High Functional Digital Signatures},
year = {2025},
isbn = {9798400710780},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3702359.3702360},
doi = {10.1145/3702359.3702360},
abstract = {In "Personal Data Protection Considerations in Blockchain-Based Information Management" presented at SCIS2023, the use of various digital signatures to protect privacy by encrypting educational data while preventing the decryptor, the student, from tampering with the decrypted data was proposed in the use of blockchain. In that proposal, such as Convertible Undeniable Signatures, and Designated Confirmer Signatures were mentioned. However, as its verification conducted interactively, numerous parameters are required for verification. When such information is handled in the blockchain, it is stored as immutable information, and a single leak can lead to long-term attacks. In addition, interactive verification is inefficient compared to non-interactive verification because of the time and effort required to send the results of calculations. In this paper, we introduce the use of Efficient Convertible Limited Verifier Signatures (ECLVS). This digital signature allows for non-interactive signature verification by limited verifiers. We propose a three-pattern verifier signature verification scheme with three convertible limited verifier signatures, where the verifier is designated as the verifier and the verified signatures are assigned to different entities. We also discuss the need for a trusted third party to be designated as the verifier and to perform the verification.},
booktitle = {Proceedings of the 2024 5th International Artificial Intelligence and Blockchain Conference},
pages = {1–9},
numpages = {9},
keywords = {Blockchain, Digital Signatures, Efficient Convertible Limited Verifier Signatures},
location = {
},
series = {AIBC '24}
}

@inproceedings{10.1145/3605098.3636017,
author = {Lin, Yi-Syuan and Liang, Yu-Pei and Chang, Yuan-Hao and Shih, Wei-Kuan and Lim, Wen-Sheng},
title = {Bridging DNA Storage and Computation: An Integrated Framework for Efficient Biomolecular Data Management},
year = {2024},
isbn = {9798400702433},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3605098.3636017},
doi = {10.1145/3605098.3636017},
abstract = {In the era of rapid technological advancements, Cyber-Physical Systems (CPS) play a pivotal role in sectors like healthcare and industrial automation. However, with the escalating demand for data storage in CPS, traditional storage media may be inadequate in the future. DNA (deoxyribonucleic acid) storage is emerging as a promising alternative, given its high density, long-term durability, and stability. However, several challenges persist in DNA storage, notably the high costs and large time consumption associated with accessing DNA data. Fortunately, DNA computing technology presents a possible solution to these challenges. This direct computation method offers time and cost savings and enhanced computational efficiency. In this work, we present DCDS (DNA Computer with DNA Storage) to ensure efficient data access, and propose the DCA (dual-phase clustering approach) to mitigate contamination and errors during data transportation. DCDS holds the potential to enhance the efficiency with high accuracy of DNA computing systems significantly. DCA leads to a time savings of 87--91% on the DNA Computer unit, mainly by reducing unnecessary cleaning steps in DMF (Digital Microfluidics).},
booktitle = {Proceedings of the 39th ACM/SIGAPP Symposium on Applied Computing},
pages = {196–203},
numpages = {8},
keywords = {DNA storage, DNA computing, data management strategies, digital microfludic (DMF), data contamination mitigation},
location = {Avila, Spain},
series = {SAC '24}
}

@inproceedings{10.1145/3685651.3686698,
author = {Zafeiropoulos, Anastasios and Filinis, Nikos and Spatharakis, Dimitrios and Dimolitsas, Ioannis and Fotopoulou, Eleni and Vassilakis, Constantinos and Papavassiliou, Symeon},
title = {Data Management and Exchange between a Meta-Orchestration Platform and Data Spaces},
year = {2024},
isbn = {9798400709845},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3685651.3686698},
doi = {10.1145/3685651.3686698},
abstract = {A transition is underway towards the development of orchestration systems for the distributed computing continuum, where microservices-based applications are deployed and managed over resources that span from the Internet of Things (IoT) to the edge to the cloud part of it. In parallel, distributed monitoring frameworks are deployed to manage the vast amount of data produced to assist orchestration actions, optimal deployment of Machine Learning (ML) workflows, and processing of data produced by the IoT infrastructure that are related to vertical industries. In the current work, we detail the data collection and management approach that we follow in the development of a novel meta-orchestration platform for processing and sharing such data. For the latter, the potential for exploitation of the produced data is analyzed along with the interlinkage of the meta-orchestration platform with emerging work in the domain of Data Spaces. Opportunities and limitations for such an interlinkage are discussed.},
booktitle = {Proceedings of the 4th Eclipse Security, AI, Architecture and Modelling Conference on Data Space},
pages = {33–36},
numpages = {4},
keywords = {Computing Continuum, Data Spaces, Distributed Application, Meta-Orchestration, Observability},
location = {Mainz, Germany},
series = {eSAAM '24}
