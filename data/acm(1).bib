articleno = {55},
numpages = {5},
keywords = {conversation design platform, conversational agents, open source, research software, visual programming},
location = {Eindhoven, Netherlands},
series = {CUI '23}
}

@inproceedings{10.1145/3526064.3534111,
author = {Bellavita, Julian and Sim, Alex and Wu, Kesheng and Monga, Inder and Guok, Chin and W\"{u}rthwein, Frank and Davila, Diego},
title = {Studying Scientific Data Lifecycle in On-demand Distributed Storage Caches},
year = {2022},
isbn = {9781450393157},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3526064.3534111},
doi = {10.1145/3526064.3534111},
abstract = {The XRootD system is used to transfer, store, and cache large datasets from high-energy physics (HEP). In this study we focus on its capability as distributed on-demand storage cache. Through exploring a large set of daily log files between 2020 and 2021, we seek to understand the data access patterns that might inform future cache design. Our study begins with a set of summary statistics regarding file read operations, file lifetimes, and file transfers. We observe that the number of read operations on each file remains nearly constant, while the average size of a read operation grows over time. Furthermore, files tend to have a consistent length of time during which they remain open and are in use. Based on this comprehensive study of the cache access statistics, we developed a cache simulator to explore the behavior of caches of different sizes. Within a certain size range, we find that increasing the XRootD cache size improves the cache hit rate, yielding faster overall file access. In particular, we find that increase the cache size from 40TB to 56TB could increase the hit rate from 0.62 to 0.89, which is a significant increase in cache effectiveness for modest cost.},
booktitle = {Fifth International Workshop on Systems and Network Telemetry and Analytics},
pages = {43–50},
numpages = {8},
keywords = {data, distributed cache, file, lifecycle, xrootd},
location = {Minneapolis, MN, USA},
series = {SNTA '22}
}

@inproceedings{10.1145/3637543.3654620,
author = {Medeiros, Daniel and Gregory, Eric B. and Couvee, Philippe and Hawkes, James and Gougeaud, Sebastien and Gilliot, Maike and Bressand, Olivier and Valeri, Yoann and Jaeger, Julien and Chapon, Damien and Bournaud, Frederic and Strafella, Lo\"{\i}c and Caviedes-Voulli\`{e}me, Daniel and Tashakor, Ghazal and Zjupa, Jolanta and Holicki, Max and Ridley, Tom and M\"{u}ller, Yanik and Guimar\~{a}es, Filipe Souza Mendes and Frings, Wolfgang and Mirus, Jan-Oliver and Zhukov, Ilya and Borba, Eric Rodrigues and Moti, Nafiseh and Salkhordeh, Reza and Derbey, Nadia and Mimouni, Salim and Derr, Simon and Gursoy, Buket Benek and Grogan, James and Furm\'{a}nek, Radek and Golasowski, Martin and Slaninov\'{a}, Kate\v{r}ina and Martinovi\v{c}, Jan and Falt\'{y}nek, Jan and Wong, Jenny and Cakircali, Metin and Quintino, Tiago and Smart, Simon and Iffrig, Olivier and Narasimhamurthy, Sai and Happ, Sonja and Rauh, Michael and Krempel, Stephan and Wiggins, Mark and Nov\'{a}\v{c}ek, Ji\v{r}\'{\i} and Brinkmann, Andr\'{e} and Markidis, Stefano and Deniel, Philippe},
title = {IO-SEA: Storage I/O and Data Management for Exascale Architectures},
