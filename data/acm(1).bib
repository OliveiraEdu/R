@article{10.1145/3325061.3325064,
author = {Wu, Chin-Hsien and Huang, Cheng-Wei and Chang, Chen-Yu},
title = {A data management method for databases using hybrid storage systems},
year = {2019},
issue_date = {March 2019},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {19},
number = {1},
issn = {1559-6915},
url = {https://doi.org/10.1145/3325061.3325064},
doi = {10.1145/3325061.3325064},
abstract = {When applications require high I/O performance, solid-state drives (SSDs) are often preferable because they perform better than traditional hard-disk drives (HDDs). Therefore, database system response time can be improved by moving frequently used data to SSDs. However, because capacity is both more limited and more expensive for SSDs than it is for HDDs, there is a need to determine which data are most appropriate to migrate from HDDs to SSDs. In this paper, we propose a data management method for databases using SSDs by considering an integrated mechanism and a migration rule for performing migrations between HDDs and SSDs. The proposed method can provide database systems with high I/O performance by properly moving high-priority data to SSDs with fast access capabilities while maintaining the low-priority data on HDDs, which have lower costs. The results of experiments show that the proposed method can achieve the goal while requiring only small amounts of SSD capacity.},
journal = {SIGAPP Appl. Comput. Rev.},
month = apr,
pages = {34–47},
numpages = {14},
keywords = {data placement, hybrid storage systems, solid-state drives (SSDs)}
}

@inproceedings{10.1145/3422713.3422715,
author = {Han, Bing and Chen, Zhenxiang and Liu, Cong and Shang, Mingyue},
title = {Design and Implementation of Big Data Management Platform for Android Applications},
year = {2020},
isbn = {9781450387859},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3422713.3422715},
doi = {10.1145/3422713.3422715},
abstract = {In recent years, the number of Android malicious applications has grown rapidly. In the field of network security, the detection of Android malicious applications has been a hot spot. Traditional Android malicious application detection has two methods: dynamic detection and static detection. With the development of network technology, network traffic has increased dramatically, analysis and researchers pay attention to malware detection based on network traffic. As the number of applications increases, application data management becomes particularly important. This paper proposes a method of the collection, store, analysis and visualization of Android applications. This platform provides a simple way to access data, which has broad application prospects.},
booktitle = {Proceedings of the 3rd International Conference on Big Data Technologies},
pages = {36–40},
numpages = {5},
keywords = {Android, Data management, Malicious applications, Network traffic},
location = {Qingdao, China},
series = {ICBDT '20}
}

@inproceedings{10.1145/3419249.3420110,
author = {Nunes Vilaza, Giovanna and Maharjan, Raju and Coyle, David and Bardram, Jakob},
title = {Futures for Health Research Data Platforms From the Participants’ Perspectives},
year = {2020},
isbn = {9781450375795},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3419249.3420110},
doi = {10.1145/3419249.3420110},
abstract = {In clinical cohort studies, researchers analyse the life history of population groups to understand the evolution of diseases. Health research data platforms came to facilitate such studies as they allow multiple projects to share access to cohorts’ non-identifiable health information. Some latest initiatives are also starting to include mobile-generated data in their research programmes. Although seemly beneficial, it is not yet clear how potential participants feel about contributing to the new platforms: there is a need to investigate potential factors related to the acceptance in this specific context. In this paper, previous works from related contexts were brought together and, along with a qualitative study, composed a participant-centred perspective of enablers and barriers for contribution. We found that there is an apparent misalignment between current implementations and participants’ preferences, leading us to propose design guidelines for future developments which can make participation more ethical and engaging.},
booktitle = {Proceedings of the 11th Nordic Conference on Human-Computer Interaction: Shaping Experiences, Shaping Society},
articleno = {39},
numpages = {14},
keywords = {acceptance, data platforms, ethics., health research, personal sensing, privacy},
location = {Tallinn, Estonia},
series = {NordiCHI '20}
}

@inproceedings{10.1145/3712285.3759856,
author = {Cappello, Franck and Underwood, Robert and Alexeev, Yuri and Baker, Alison and Bozda\u{g}, Ebru and Burtscher, Martin and Chard, Kyle and Di, Sheng and Felker, Kyle Gerard and O'Grady, Paul Christopher and Guo, Hanqi and Huang, Yafan and Jiang, Peng and Jin, Sian and Johansson, Petter and Li, Shaomeng and Liang, Xin and Lindahl, Erik and Lindstrom, Peter and Luki\'{c}, Zarija and Lundborg, Magnus and Lykov, Danylo and Nagaso, Masaru and Sato, Kento and Singh, Amarjit and Son, Seung Woo and Song, Shihui and Tang, William and Tao, Dingwen and Tian, Jiannan and Yoshii, Kazutomo and Zhao, Kai},
title = {What to Support When You’re Compressing: The State of Practice Gaps and Opportunities for Scientific Data Compression},
year = {2025},
isbn = {9798400714665},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3712285.3759856},
doi = {10.1145/3712285.3759856},
abstract = {Over the last nearly 20 years, lossy compression has become an essential aspect of HPC applications’ data pipelines, allowing them to overcome limitations in storage capacity and bandwidth and, in some cases, increase computational throughput and capacity. However, with the adoption of lossy compression comes the requirement to assess and control the impact lossy compression has on scientific outcomes. In this work, we take a major step forward in describing the state of practice and by characterizing workloads. We examine applications’ needs and compressors’ capabilities across 9 different supercomputing application domains. We present 24 takeaways that provide best practices for applications, operational impacts for facilities achieving compressed data, and gaps in application needs not addressed by production compressors that point towards opportunities for future compression research.},
booktitle = {Proceedings of the International Conference for High Performance Computing, Networking, Storage and Analysis},
pages = {1966–1979},
numpages = {14},
keywords = {Error-Bounded Lossy Compression, High-Performance Computing, I/O Optimization, Requirements Analysis, State of Practice},
location = {
},
series = {SC '25}
}

@inproceedings{10.1145/3785021.3788011,
author = {Deng, Yangshen and Fruth, Michael and Scherzinger, Stefanie},
title = {Reproducibility Report for ACM SIGMOD 2025 Paper: 'Live Patching for Distributed In-Memory Key-Value Stores'},
year = {2026},
isbn = {9798400723759},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785021.3788011},
doi = {10.1145/3785021.3788011},
abstract = {This paper proposes a new solution to handle the service downtime and performance degradation issues posed by traditional rolling updates when maintaining distributed in-memory key-value stores (IMKVS). The authors propose a live patching system for Redis Cluster which proactively manages software updates by modifying process memory directly without restarting nodes, while leveraging the cluster-internal gossip protocol for automatic patch distribution. The authors present a set of experiments comparing the efficacy of live patching (LP) to state-of-the-art rolling updates (CP) on a range of cluster sizes and memory states up to 200~GiB. We find that on the hardware specified (including Intel Xeon and AMD EPYC configurations) we were able to reproduce the key results and plots shown in the paper, illustrating the robust nature of these experiments and confirming that live patching achieves constant-time updates regardless of data size. Furthermore, the authors provided well-written shell scripts and easy-to-follow instructions within a QEMU virtual machine environment to reproduce this material.},
booktitle = {Reproducibility Reports of the 2025 International Conference on Management of Data},
pages = {139–142},
numpages = {4},
keywords = {live patching, benchmarking, database cluster, key-value stores},
location = {Germany},
series = {SIGMOD ARI Reports '25}
}

@inproceedings{10.1145/3528226.3528376,
author = {Rydningen, Eivind Solberg and \r{A}sberg, Erika and Jaccheri, Letizia and Li, Jingyue},
title = {Advantages and opportunities of the IOTA tangle for health data management: a systematic mapping study},
year = {2023},
isbn = {9781450393317},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3528226.3528376},
doi = {10.1145/3528226.3528376},
abstract = {The merging of Distributed Ledger Technology (DLT) and the Internet of Things (IoT) has opened new opportunities for innovation in health data management. Issues such as security breaches, privacy violations and fragmented data are just some of the problems that DLT might solve. This research investigates how the IOTA Tangle can provide reliable and secure health data management.A systematic mapping study on 10 primary papers from year 2018 to 2021 was conducted with a comparison with findings from previous studies. We discovered that the existing research has been conducted within the knowledge areas of health data management and its relation to the IOTA Tangle, blockchain, and IoT.The results show that the IOTA Tangle is a good candidate for health data management and that it has been successfully done as proof of concepts. The Tangle is also highlighted in the literature as being well suited for the IoT. This thesis forms the basis for further research into the suitability of the IOTA Tangle in health data management.},
booktitle = {Proceedings of the 5th International Workshop on Emerging Trends in Software Engineering for Blockchain},
pages = {9–16},
numpages = {8},
keywords = {IOTA tangle, blockchain, distributed ledger technology, health data management, internet of things, systematic mapping study},
location = {Pittsburgh, Pennsylvania},
series = {WETSEB '22}
}

