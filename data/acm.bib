}

@inproceedings{10.1145/3205230.3205235,
author = {Boyen, Xavier and Carr, Christopher and Haines, Thomas},
title = {Graphchain: a Blockchain-Free Scalable Decentralised Ledger},
year = {2018},
isbn = {9781450357586},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3205230.3205235},
doi = {10.1145/3205230.3205235},
abstract = {Blockchain-based replicated ledgers, pioneered in Bitcoin, are effective against double spending, but inherently attract centralised mining pools and incompressible transaction delays.  We propose a framework that forgoes blockchains, building a decentralised ledger as a self-scaling graph of cross-verifying transactions. New transactions validate prior ones, forming a thin graph secured by a cumulative proof-of-work mechanism giving fair and predictable rewards for each participant. We exhibit rapid confirmation of new transactions, even across a large network affected by latency. We also show, both theoretically and experimentally, a strong convergence property: that any valid transaction entering the system quickly become enshrined in the ancestry of all future transactions.},
booktitle = {Proceedings of the 2nd ACM Workshop on Blockchains, Cryptocurrencies, and Contracts},
pages = {21–33},
numpages = {13},
keywords = {consensus, cryptocurrencies, decentralisation},
location = {Incheon, Republic of Korea},
series = {BCC '18}
}

@inproceedings{10.1145/3724154.3724246,
author = {Ji, Shijie and Hao, Jiahan and Shi, Zhuyu and Hu, Wanli and Yang, Ning},
title = {Research on key technologies of park carbon emission monitoring and accounting based on blockchain},
year = {2025},
isbn = {9798400711862},
publisher = {Association for Computing Machinery},
