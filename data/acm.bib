publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768801.3768831},
abstract = {With the accelerated intelligent transformation of the power industry, the importance of smart power consumption platforms in enhancing power consumption efficiency and ensuring power consumption safety is becoming increasingly prominent. Based on methods such as literature research and case analysis, this paper explores the path of integrating edge technology with blockchain technology to create a smart power consumption platform. Research has found that by designing a cloud-edge-device architecture, leveraging edge technology to achieve rapid data processing and response, and integrating blockchain technology to ensure data security and trustworthiness, a smart power consumption platform can be effectively constructed. However, during the platform development process, challenges such as technical compatibility, cost control, and data privacy and compliance are faced. In response to these challenges, this paper proposes countermeasures such as unified standards, reasonable planning of equipment deployment, and anonymization processing, with the aim of providing useful references for technological innovation and improvement of power consumption service quality in the power industry.},
booktitle = {Proceedings of the 2025 2nd International Conference on Big Data and Digital Management},
pages = {181–186},
numpages = {6}
}

@inproceedings{10.1145/3551902.3564854,
author = {Syed, Madiha and Ul Abadin, Zain},
title = {A Pattern for Proof of Stake Consensus Algorithm in Blockchain},
