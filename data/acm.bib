}

@inproceedings{10.1145/3559795.3559797,
author = {Wang, Yibai and Liu, Yiyang},
title = {Loan Chain: A Blockchain-Based Framework for Smart Credit Lending},
year = {2022},
isbn = {9781450396622},
publisher = {Association for Computing Machinery},
