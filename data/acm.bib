doi = {10.1145/3703935.3704103},
abstract = {Abstract:This paper proposes a decentralized personal credit risk assessment scheme that combines the random forest algorithm and smart contract technology. Traditional credit risk assessment suffers from the problems of information opacity and assessment bias. To improve the accuracy and fairness of the assessment,  the random forest model was embed in a smart contract to achieve automated and transparent credit risk assessment. Through experimental verification, Random Forest performs well in handling credit risk assessment in terms of accuracy, precision and recall.  This scheme ensures the security and fairness of the assessment process while improving the precision of risk assessment.},
booktitle = {Proceedings of the 2024 7th International Conference on Artificial Intelligence and Pattern Recognition},
pages = {858–864},
numpages = {7},
keywords = {Blockchain Technology, Credit Risk Assessment, Random Forests, Smart Contracts},
location = {
},
series = {AIPR '24}
}

