}

@inproceedings{10.1145/3785021.3788014,
author = {Zhang, William and Chen, Qing},
title = {Reproducibility Report for ACM SIGMOD 2025 Paper: 'InTime: Towards Performance Predictability In Byzantine Fault Tolerant Proof-of-Stake Consensus'},
year = {2026},
isbn = {9798400723759},
