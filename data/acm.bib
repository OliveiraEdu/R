@inproceedings{10.1145/3570236.3570240,
author = {Chen, Rong},
title = {Operation mechanism and scheduling optimization of micro-grid power market based on block chain},
year = {2023},
isbn = {9781450396714},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
