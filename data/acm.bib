abstract = {In order to realize optimal allocation of clean energy, scheduling optimization of blockchain-supported micro-grid power market is studied. Based on the similar network topology of micro-grid market and blockchain, the overall framework of micro-grid market based on blockchain is constructed. The block chain management platform is used to obtain data information, and the model Predictive control (MPC) method is used to optimize the scheduling operation of the micro-grid market. Taking IEEE33 node system as an example, the analysis results verify the effectiveness of the micro-grid transaction model supported by block chain, indicating that the block chain management platform combined with model predictive control optimization scheduling, enhances the robustness of the micro-grid market, improves the accuracy of load power prediction and energy utilization in the process of power transaction.},
booktitle = {Proceedings of the 7th International Conference on Intelligent Information Processing},
articleno = {4},
numpages = {5},
keywords = {Block chain, MPC, Micro-grid, Scheduling optimization, electricity transaction, smart contract},
location = {Bucharest, Romania},
series = {ICIIP '22}
