Journal = {MICROBIAL GENOMICS},
Year = {2023},
Volume = {9},
Number = {5},
Month = {MAY},
Abstract = {The Swiss Pathogen Surveillance Platform (SPSP) is a shared secure
   surveillance platform between human and veterinary medicine, to also
   include environmental and foodborne isolates. It enables rapid and
   detailed transmission monitoring and outbreak surveillance of pathogens
   using whole genome sequencing data and associated metadata. It features
   controlled data access, complex dynamic queries, dedicated dashboards
   and automated data sharing with international repositories, providing
   actionable results for public health and the vision to improve societal
   well -being and health.},
