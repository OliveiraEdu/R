@article{ WOS:001536579400002,
Author = {Gregori, Luca and Lazzaro, Pasquale Leonardo and Lazzaro, Marialaura and
   Missier, Paolo and Torlone, Riccardo},
Title = {An LLM-guided platform for multi-granular collection and management of
   data provenance},
Journal = {JOURNAL OF BIG DATA},
Year = {2025},
Volume = {12},
Number = {1},
Month = {JUL 26},
Abstract = {As machine learning and AI systems become more prevalent, understanding
   how their decisions are made is key to maintaining their trust. To solve
   this problem, it is widely accepted that fundamental support can be
   provided by the knowledge of how data are altered in the pre-processing
   phase, using data provenance to track such changes. This paper focuses
   on the design and development of a system for collecting, managing, and
   querying data provenance of data preparation pipelines in data science.
   An investigation of publicly available machine learning pipelines is
   conducted to identify the most important features required for the tool
   to achieve impact on a broad selection of pre-processing data
   manipulation. Building on this study, we present an approach for
   transparently collecting data provenance based on the use of an LLM to:
   (i) automatically rewrite user-defined pipelines in a format suitable
   for this activity and (ii) store an accurate description of all the
   activities involved in the input pipelines for supporting the
   explanation of each of them. We then illustrate and test implementation
   choices aimed at supporting the provenance capture for data preparation
   pipelines efficiently in a transparent way for data scientists.},
