@article{ WOS:001690414500001,
Author = {Kanu, Victor Ikenna and Ajakwe, Simeon Okechukwu and Lee, Jae Min and
   Kim, Dong-Seong},
Title = {Deterministic protein structure and binding site analysis through
   blockchain-integrated workflow verification},
Journal = {ICT EXPRESS},
Year = {2026},
Volume = {12},
Number = {1},
Pages = {83-91},
Month = {FEB},
Abstract = {Reproducibility is a critical issue in protein structure analysis,
   especially in drug discovery workflows. Previous methods do not
   consistently produce reliable results across systems and do not provide
   deterministic outcomes in protein analysis. This work proposes a
   tri-layered blockchain-inspired architecture that leverages
   cryptographic metadata and capabilities to validate protonation states
   and guarantee deterministic results and data integrity across protein
