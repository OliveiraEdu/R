Title = {TOWARDS A SEMANTIC BASED HUB PLATFORM OF VAULTED SYSTEMS: HBIM MEETS A
   GEODB},
Booktitle = {2ND INTERNATIONAL CONFERENCE OF GEOMATICS AND RESTORATION (GEORES 2019)},
