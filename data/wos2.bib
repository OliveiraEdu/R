@article{ WOS:000835514600005,
Author = {Zheng, Wei and Gan, Rui and Yuan, Qiping and Guo, Heru and Ma, Hengben
   and Zhang, Ming and Xiao, Bingjia and Pan, Yuan},
Title = {Design and implementation of a dynamic system simulation framework for
   plasma control system verification platform},
Journal = {FUSION ENGINEERING AND DESIGN},
Year = {2022},
Volume = {182},
Month = {SEP},
Abstract = {The plasma control system (PCS) is a key part in tokamak operations,
   which requires test and verification. Dynamic system simulation tools
   have been widely utilized to build a simulation environment to verify
   the design of plasma control systems as well as other parts of tokamak
   systems under various operation scenarios, save the time and cost of
   real discharges, improve the efficiency of deployment and reduce risks.
   To provide a simulation platform based on open-source software as part
   of the infrastructure of the PCS-VP (Verification Platform) of the China
   Fusion Engineering Test Reactor (CFETR), a framework named DSSim
   (Dynamic System Simulation) is proposed. It is an environment for
   dynamic system simulation based on Python, which enables users to build
   and simulate hierarchical block diagram models with interconnected
   systems that corresponds to different dynamic systems. Solutions for
   special tasks that helps improve the accuracy of simulation like
   flattening the model hierarchy, scheduling system execution order and
   solving continuous systems are implemented and will be automatically
   invoked in different phases of simulation. A GUI client with the DSSim
   framework built in is developed to allow for constructing and simulating
   block diagram models in a more user-friendly way. A model of the vacuum
   field system of the Experimental and Advanced Superconducting Tokamak
   (EAST) is built and simulated with DSSim and the result is compared with
   that of the same model in MATLAB/Simulink to test the framework's
   precision and usability.},
