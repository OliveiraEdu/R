Title = {FaaSOnto: A Semantic Model for Enabling Function-as-a-Service Platform
   Selection},
Booktitle = {BUSINESS MODELING AND SOFTWARE DESIGN, BMSD 2023},
Series = {Lecture Notes in Business Information Processing},
Year = {2023},
Volume = {483},
