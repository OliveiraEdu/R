@inproceedings{ WOS:001444018900012,
Author = {Abbas, Maryam and Al-Aama, Arwa Yousuf},
Book-Group-Author = {IEEE},
Title = {Halal Food Verification Using Blockchain Technology: A Proposed
   Framework for Saudi Arabia},
Booktitle = {2024 6TH INTERNATIONAL CONFERENCE ON BLOCKCHAIN COMPUTING AND
   APPLICATIONS, BCCA},
Year = {2024},
Pages = {82-90},
Note = {6th International Conference on Blockchain Computing and Applications,
   Zayed University, Dubai, U ARAB EMIRATES, NOV 26-29, 2024},
Abstract = {The process of verifying whether foods meet Halal standards according to
   Islamic Sharia law has strained many Islamic countries. This is
   especially important due to an increased variety of processed and
   imported foods. This research proposes a Halal Food Verification
   Framework for importing food to the Saudi food market. The framework
   uses blockchain technology to trace food imported to Saudi Arabia from
   its origin and to detect whether it is Halal. It can be used by
   authorities to enhance the integrity of Halal verification. The paper
   represents the results of testing a prototype developed using the
   framework and comparing its functionality and effectiveness to the
   currently used traditional verification method. The results show that
   blockchain in Halal food tracking is more effective when compared to
   traditional methods, as it increases the integrity and availability of
   Halal Authentication. If used effectively by the different stakeholders,
   it provides faster, safer, and more accurate results, as it decreases
   the time needed from days to seconds for the consumer to check
   authenticity, and is fraudulent-safe and tamper-proof, resulting in
   higher stakeholder trust.},
