@article{ WOS:001427478300001,
Author = {Ben Rhaiem, Olfa and Amara, Marwa and Zaghdoud, Radhia and Chaari, Lamia
   and Metaab, Maha},
Title = {Secure blockchain-based electronic toll collection system: enhancing
   location verification and smart contract resilience},
Journal = {JOURNAL OF THE CHINESE INSTITUTE OF ENGINEERS},
Year = {2025},
Volume = {48},
Number = {5},
Pages = {612-624},
Month = {JUL 4},
Abstract = {Electronic Toll Collection (ETC) systems aim to replace the traditional
   toll and lies in enhancing traffic flow efficiency. However current ETC
   systems are not secure to preserve privacy for vehicle's information and
   help against theft of funds. This makes automatic payment not efficient
   and vulnerable to attacks (i.e. Reentrancy attack). To address these
   challenges, our paper proposes leveraging Ethereum blockchain and smart
   contracts for automatic payment mechanisms in ETC systems. The primary
   challenges include authenticating vehicle data, automatically deducting
   fees, and safeguarding against reentrancy attacks on smart contracts
   while maintaining the confidentiality of distance-related information.
   To tackle these issues, this paper introduces a novel decentralized
   application (DApp), called DAppETC. This solution employs a private
   blockchain with end-to-end verification algorithms at toll points. These
   algorithms ensure both the protection of sensitive distance information
   and the enhancement of smart contract security against reentrancy
   attacks. The performance evaluation of the proposed system is carried
   out on a private blockchain. To assess the robustness of our approach,
   we introduce a hacker smart contract to evaluate the effectiveness of
   the deployed end-to-end verification algorithms at both entry and exit
   toll points.},
