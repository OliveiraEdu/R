@inproceedings{ WOS:001688973400032,
Author = {Orru, Daniele and Pinna, Andrea and Tonelli, Roberto},
Editor = {Bartoletti, M and Schifanella, C and Vitaletti, A},
Title = {Low-Cost Tamper-Proof IoT Devices to Improve Data Origin Verification
   and Privacy in Blockchain-Based Energy Consumption Records},
Booktitle = {DISTRIBUTED LEDGER TECHNOLOGY WORKSHOP 2024, DLT 2024},
