Year = {2022},
Pages = {854-859},
Note = {IEEE International Conference on Communications (ICC), Seoul, SOUTH
   KOREA, MAY 16-20, 2022},
Organization = {IEEE},
Abstract = {This paper proposes a blockchain-based secure and optimal data pricing
   scheme for ride-sharing. It mainly focuses on securing the data
   transactions between vehicle owners and customers. It utilizes a
   communication network, i.e., 6G, to facilitate the low latency and high
   data rate transmissions between vehicle owner and customer. We applied a
   reverse Stackelberg game theory approach to yield the optimal payoff for
   vehicle owners and customers. The performance results of the proposed
   system over a 6G communication network is estimated by differentiating
   it with conventional networks such as 4G and 5G. The performance is
   evaluated considering the parameters latency, scalability, and the
   optimal payoff for the system. The performance results conclude that the
   proposed system is secure, reliable, and yields the optimal payoff for
   vehicle owners and customers.},
