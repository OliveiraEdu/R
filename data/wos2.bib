Title = {A Public Blockchain-based Identity Management Scheme and Petri Net-based
   Verification},
Booktitle = {20TH INT CONF ON UBIQUITOUS COMP AND COMMUNICAT (IUCC) / 20TH INT CONF
   ON COMP AND INFORMATION TECHNOLOGY (CIT) / 4TH INT CONF ON DATA SCIENCE
   AND COMPUTATIONAL INTELLIGENCE (DSCI) / 11TH INT CONF ON SMART
   COMPUTING, NETWORKING, AND SERV (SMARTCNS)},
Year = {2021},
Pages = {361-368},
Note = {20th Int Conf on Ubiquitous Comp and Communicat (IUCC) / 20th Int Conf
   on Comp and Information Technology (CIT) / 4th Int Conf on Data Science
   and Computational Intelligence (DSCI) / 11th Int Conf on Smart
   Computing, Networking, and Serv (SmartCNS), ELECTR NETWORK, DEC 20-22,
   2021},
Abstract = {The classical Public Key Infrastructure (PKI) has some weaknesses, such
   as risks brought by the centralized storage of certification centers,
   authentication failure due to offline of authentication service and
   cumbersome procedures of certificate revocations. This paper proposes a
   public blockchain-based identity management scheme to improve them. An
   identity information management protocol and a transaction construction
   protocol are specified to integrate identity signatures with blockchain
   transaction signatures. Three operation methods, identity registration,
   verification and revocation methods, are proposed to register, verify
   and revocation identity information to/from public blockchain. The
   register operation stores identities information on the blockchain, the
   verification and revocation methods can be done via blockchain, both of
   which improve the robustness of the proposed scheme. Finally, the scheme
   is modeled by Petri nets and verified its correctness using state-space
   graph and transition sequence analysis methods.},
