@article{ WOS:000455286500015,
Author = {Lanteri, Marion C. and Kanias, Tamir and Keating, Sheila and Stone, Mars
   and Guo, Yuelong and Page, Grier P. and Brambilla, Donald J. and
   Endres-Dighe, Stacy M. and Mast, Alan E. and Bialkowski, Walter and
   D'Andrea, Pam and Cable, Ritchard G. and Spencer, Bryan R. and Triulzi,
