   Yu, Ching-Ching; Mir, Faizan Ul Haq; Whittaker, Andrew S., Univ Buffalo, Dept Civil Struct \& Environm Engn, Buffalo, NY USA.
   Kong, Fande; Lindsay, Alexander D., Idaho Natl Lab, Computat Frameworks, Idaho Falls, ID 83402 USA.},
DOI = {10.1002/eqe.3659},
