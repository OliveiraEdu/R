@article{ WOS:001337281700001,
Author = {Altinpulluk, Nur Banu and Altinpulluk, Deniz and Ramanan, Paritosh and
   Paulson, Noah H. and Qiu, Feng and Babinec, Susan J. and Yildirim, Murat},
Title = {Catalyzing deep decarbonization with federated battery diagnosis and
   prognosis for better data management in energy storage systems},
Journal = {CELL REPORTS PHYSICAL SCIENCE},
Year = {2024},
Volume = {5},
Number = {10},
Month = {OCT 16},
Abstract = {Industrial data analytics methods play a central role in improving
   energy storage performance and efficiency, impacting the future of
   electrified transportation and renewable electricity generation.
   However, significant challenges hinder the large-scale deployment of
   batteries. Conventional methods rely on centralized collection and
   processing of fleet-level data, leading to database size issues and
   privacy concerns due to potential data breaches. To enable scalable
   deployment of battery management systems, this article proposes a
   federated battery diagnosis and prognosis model, which distributes the
   processing of battery standard current-voltage- time-usage data in a
   privacy-preserving manner. Instead of transferring the raw data, this
   approach communicates only the locally processed parameters, thus
   reducing communication load and preserving data confidentiality. The
   federated model offers a paradigm shift in battery health management
   through privacy-preserving distributed methods for battery data
   processing and lifetime prediction, ensuring the reliable and
   sustainable deployment of lithium-ion batteries in a rapidly evolving
   world.},
