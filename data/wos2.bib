@article{ WOS:000636183900010,
Author = {Trippel, Thorsten and Zinn, Claus},
Title = {Lessons learned: on the challenges of migrating a research data
   repository from a research institution to a university library},
Journal = {LANGUAGE RESOURCES AND EVALUATION},
Year = {2021},
Volume = {55},
Number = {1, SI},
Pages = {191-207},
Month = {MAR},
Abstract = {The transfer of research data management from one institution to another
   infrastructural partner is all but trivial, but can be required, for
   instance, when an institution faces reorganization or closure. In a case
   study, we describe the migration of all research data, identify the
   challenges we encountered, and discuss how we addressed them. It shows
   that the moving of research data management to another institution is a
   feasible, but potentially costly enterprise. Being able to demonstrate
   the feasibility of research data migration supports the stance of data
   archives that users can expect high levels of trust and reliability when
   it comes to data safety and sustainability.},
