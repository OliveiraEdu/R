Title = {A data integrity verification service for cloud storage based on
   building blocks},
Booktitle = {2018 8TH INTERNATIONAL CONFERENCE ON COMPUTER SCIENCE AND INFORMATION
   TECHNOLOGY (CSIT)},
Series = {International Conference on Computer Science and Information Technology},
