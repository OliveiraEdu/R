Title = {Modeling Blockchain, Artificial Intelligence, and New Public Management
   Through a Semantic Ontology},
Booktitle = {COLLABORATION IN KNOWLEDGE DISCOVERY AND DECISION MAKING, DECISIONING
   2024},
