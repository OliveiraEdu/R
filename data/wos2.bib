@inproceedings{ WOS:001589453100152,
Author = {Li, Lei and Ning, Hao and Zhang, Jian},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Research on Intelligent Dispatching System of Mobile Energy Storage
   Equipment Based on Semantic Analysis},
Booktitle = {2025 5TH ASIA-PACIFIC CONFERENCE ON COMMUNICATIONS TECHNOLOGY AND
   COMPUTER SCIENCE, ACCTCS},
Year = {2025},
Pages = {895-900},
Note = {5th Asia-Pacific Conference on Communications Technology and Computer
   Science-ACCTCS, Shenyang, PEOPLES R CHINA, APR 23-25, 2025},
Organization = {IEEE Computer Society},
Abstract = {This paper proposes an intelligent dispatching algorithm based on
   semantic analysis, which aims to optimize the dispatching decision of
   mobile energy storage equipment. By introducing semantic analysis
   technology, the algorithm can deeply understand user needs and their
   environmental changes, automatically extract key data from natural
   language descriptions, and adjust the dispatching strategy in real time.
   Compared with traditional dispatching algorithms, the algorithm proposed
   in this paper can more accurately optimize task priorities, charging and
   discharging strategies, and energy allocation based on real-time input
   information. Experimental results show that the proposed dispatching
   algorithm has significant advantages in multiple experimental scenarios,
   especially when the load fluctuates greatly and user demand changes
   rapidly, the dispatching efficiency is improved by 14.8\% and the
   response time is shortened by 18.5\%. In addition, the robustness of the
   algorithm in different user demand scenarios has also been verified, and
   it can effectively adapt to dynamically changing system loads and
   equipment states. Through these experimental results, this paper
   verifies the feasibility of semantic analysis technology in intelligent
   dispatching of energy storage equipment, and provides new ideas and
   methods for the intelligence and precision of future dispatching
   systems.},
Publisher = {IEEE COMPUTER SOC},
Address = {10662 LOS VAQUEROS CIRCLE, PO BOX 3014, LOS ALAMITOS, CA 90720-1264 USA},
