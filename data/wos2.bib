@inproceedings{ WOS:000454845100073,
Author = {Deng, Juinn-Horng and Chan, Yuan-Feng},
Book-Group-Author = {IEEE},
Title = {Adaptive Estimation of Joint RF Impairments and Envelope Nonlinear
   Parameters with Instrument Platform Verification},
Booktitle = {2018 41ST INTERNATIONAL CONFERENCE ON TELECOMMUNICATIONS AND SIGNAL
   PROCESSING (TSP)},
Year = {2018},
Pages = {323-326},
Note = {41st International Conference on Telecommunications and Signal
   Processing (TSP), Athens, GREECE, JUL 04-06, 2018},
Organization = {MUEGUETEM; SEIKEI; STUFEI; SOFIA Technical Univ; Lab Informatique
   Avancee Saint Denis Univ; FERIT},
Abstract = {This paper aims to study the estimation of RF imperfections, i.e.,
   frequency independent (FI) IQ imbalance (IQI) and DC IQ offset. Based on
   the feedback envelope detector signal, a low-complexity scheme, i.e.,
   the least mean square (LMS) adaptive algorithm, is proposed to estimate
   the IQI, DC offset, and non-linear parameters. The following steps are
   designed for the parameters estimation. First, the matrix-form RF
   impairment model and the non-linear envelope detector model are
   proposed. Next, the steepest gradient LMS algorithms are developed to
   minimize the error cost function and acquire the impairment and
   non-linear parameters. Then, the FI IQI and DC offset values can be
   estimated by the inversion of parameters. Finally, we have utilized
   Agilent instruments and the envelope detector module to confirm that the
   proposed low-complexity algorithms can provide the reliable RF
   imperfection parameters estimation.},
