@inproceedings{ WOS:001578319100021,
Author = {Singh, Kumar Gaurav and Ravichandran, Praveen Kumar and Karkun, Saurabh
   and Rajakumar, Karthik and Shanmugam, Yogeshwaran and Gupta, Pratibha},
Book-Group-Author = {IEEE},
Title = {Accelerating ATE Pattern Verification \& Debug using Emulation Platform
   - Enabling First-pass Success on Silicon},
Booktitle = {2025 IEEE 9TH INTERNATIONAL TEST CONFERENCE INDIA, ITC INDIA},
Series = {IEEE International Test Conference on India},
Year = {2025},
Note = {9th International Test Conference India-ITC INDIA, Bengaluru, INDIA, JUL
   20-22, 2025},
Organization = {IEEE Bangalore Section},
Abstract = {In modern semiconductor testing, high- quality test vectors are crucial
   for validating the structural and functional authenticity of fabricated
   silicon samples. However, the conventional approach of running test
   vectors on simulation platforms faces significant challenges due to
   extremely long execution times, especially for large System-on-Chip
   (SoC) designs. This limitation not only impedes pattern readiness and
   verification but also makes debugging sequence dependencies
   exceptionally difficult, ultimately affecting time-to-market for new
   semiconductor products. This paper presents an innovative solution: The
   Bench Test Emulator (BTE), an emulation-based environment that bridges
   the gap between simulation and actual Automated Test Equipment (ATE).
   The proposed solution implements a simple tester model that can be
   deployed on both pre-silicon emulation platforms (for e.g. Palladium)
   and post-silicon FPGA implementations. This dual-purpose approach not
   only accelerates test vector execution by approximately 100x but also
   provides a more accurate representation of the actual silicon
   environment, enabling first-pass success on hardware. Our methodology
   demonstrates significant improvements in test vector qualification time,
   reducing debug iterations from 40 days to just 8 days in real-world
   applications. The solution has been successfully implemented on multiple
   SoC platforms, proving its effectiveness in both functional and
   structural testing scenarios.},
