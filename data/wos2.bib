@article{ WOS:000629112700012,
Author = {Huang, Jinbo and Wu, Xianjun and Huang, Wendong and Wu, Xiaoli},
Title = {RETRACTED: Design of a data management system for medical Internet of
   Things based on mobile platform (Retracted Article)},
Journal = {JOURNAL OF AMBIENT INTELLIGENCE AND HUMANIZED COMPUTING},
Year = {2021},
Month = {2021 MAR 15},
Abstract = {With the development of various applications of the Internet of Things,
   the use of wireless sensor networks as a collection and transmission of
   data has become a research priority. The method of collecting and
   uploading data varies by application field. The application in the field
   of medical monitoring is an important aspect, and the detailed research
   and analysis of sensor networks in the fields of medical monitoring
   system architecture, data collection, data storage tables, and data
   upload methods have important practical value. At the same time, it also
   provides technical solutions to meet people's high-quality needs for
   medical services. The current hospital information system is independent
   and private. In addition to the normal registration, payment and
   printing of payment slips, patients cannot know more about the medical
   information that has been generated about themselves. When a patient
   sees a doctor in a different hospital or even another place, there is no
   past medical history as a reference. Patients cannot have a
   comprehensive grasp of the information retained in the medical
   information system, and at the same time they have concerns about
   privacy and security. Based on this, this paper proposes the concept of
   a distributed medical information system based on a mobile platform. As
   a combination of mobile platform and medical information, emerging
   technologies provide a solution to the current medical system problems
   and further enhance the circulation of information. Security allows
   users to have stronger control over their own information.},
