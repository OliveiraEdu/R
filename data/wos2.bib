@inproceedings{ WOS:000867070905030,
Book-Group-Author = {IEEE},
Title = {Dual-granularity Interactive Semantic Learning Based Vulnerability
   Detection Approach for Cross-platform Binary},
Booktitle = {2022 INTERNATIONAL JOINT CONFERENCE ON NEURAL NETWORKS (IJCNN)},
Series = {IEEE International Joint Conference on Neural Networks (IJCNN)},
Year = {2022},
Note = {IEEE International Conference on Fuzzy Systems (FUZZ-IEEE) / IEEE World
   Congress on Computational Intelligence (IEEE WCCI) / International Joint
   Conference on Neural Networks (IJCNN) / IEEE Congress on Evolutionary
   Computation (IEEE CEC), Padua, ITALY, JUL 18-23, 2022},
Organization = {IEEE; Int Neural Network Soc; IEEE Computat Intelligence Soc;
   Evolutionary Programming Soc; IET; Univ Padova, Dept Math Tullio Levi
   Civita; European Space Agcy; expert.ai; Elsevier; Springer Nature;
   Google; Baker \& Hughes; NVIDIA},
Abstract = {Semantic learning based vulnerability detection methods for binary are
   extensively utilized in the field of information security, which enables
   vulnerability discovery via the analysis of semantics. Despite they
   address the challenge of high time overhead from the conventional
   dynamic and static detection approaches to some extent, previous studies
   merely analyze the semantics in terms of function granularity and fail
   to consider the possibility of interactive semantics to reduce
   information loss. In this paper, we present DGIS, a vulnerability
   detection tool based on dual-granularity interactive semantics for
   binary, specifically, given the binary to be searched, DGIS first
   performs pre-processing to convert its functions into LSFGs (label
   semantic flow graphs) firstly, and then two parallel modules are
   employed to extract different types of semantic information in LSFGs,
   these two types of semantic information are performed interactive
   calculation, and fused for similarity calculation; in the end, the whole
   model outputs a detection report based on the similarity value.
   Sufficient experimental results demonstrate that our approach is
   superior to Genius, Gemini, a-Diff, VulSeeker, and Taurus.},
