@article{ WOS:000511197000023,
Author = {Xiong, Zehui and Zhang, Yang and Cong Luong Nguyen and Niyato, Dusit and
   Wang, Ping and Guizani, Nadra},
Title = {The Best of Both Worlds: A General Architecture for Data Management in
   Blockchain-enabled Internet-of-Things},
