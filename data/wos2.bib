@article{ WOS:001316838300006,
Author = {Huang, Dujuan and Sun, Tao and Zhu, Tongqing and You, Xiaoyue},
Title = {The impact of platform leadership on employee bootleg innovation: a
   verification of a moderated dual path model},
Journal = {CURRENT PSYCHOLOGY},
Year = {2024},
Volume = {43},
Number = {40},
Pages = {31372-31385},
Month = {OCT},
Abstract = {The trend of enterprise platformization is becoming increasingly
   prominent in the Internet environment, with the platform leadership
   gradually attracting great attention from enterprises and researchers.
   Platform leadership emphasizes the importance of subordinates' careers
   and encourages leaders to build development platforms for employees. The
   growth of both leaders and employees might be the key factor affecting
   employee behavior. Bootleg innovation means an individual's behavior of
   continuing to improve and promote creativity in an informal way without
   obtaining formal authorization from the leaders. It remains to be
   explored whether the bootleg innovation will be affected by platform
   leadership. Based on the cognitive-affective personality system theory
   and the person-environment fit, this paper constructs an impact model
   between platform leadership and employee bootleg innovation. Using a
   random sampling method, 450 questionnaires were distributed to employees
   of high-tech companies. The results show that (1) platform leadership
   has a positive impact on employee bootleg innovation; (2) job autonomy
   and emotional exhaustion play a mediating role between platform
   leadership and employee bootleg innovation; (3) team innovation climate
   positively regulates the relationship between platform leadership and
   employee job autonomy and emotional exhaustion. This paper reveals the
   internal mechanism of platform leadership affecting employee bootleg
   innovation through empirical study while expanding the application scope
   of cognitive-affective personality system theory. It contributes to the
   organizational behavior literature and provides theoretical inspiration
   and practical guidance for managers to properly deal with employee
   bootleg innovation behavior.},
