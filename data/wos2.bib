@article{ WOS:001263608700001,
Author = {Awasthi, Divyanshu and Khare, Priyank and Srivastava, Vinay Kumar},
Title = {RFDB: Robust watermarking scheme with Fuzzy-DnCNN using blockchain
   technique for identity verification},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2024},
Volume = {255},
Number = {B},
Month = {DEC 1},
Abstract = {Due to the vast development of computer technology, the security and
   copyright protection are the major issues which needs to be addressed.
   The medical data in one of the most important data which must be secured
   for correct diagnosis. Watermarking is a technique for securing vital
   data. Different fuzzy-based watermarking techniques have been proposed
   previously but most of them lacks in high robustness, security, and
   authentication. This paper proposes an imperceptible watermarking scheme
   using fuzzy logic for obtaining scaling factor, Henon map (HM) for
   secure transmission, Denoising convolutional neural network (DnCNN) for
   enhancing the robustness. Roughness (R) and variation in image per-pixel
   (VIPP) are used to attain scaling factor. Blockchainbased authentication
   is also carried out for identity verification of patient while hybrid
   watermark (HW) is used to enhance the security. The average increment in
   the robustness is 3.4\% while in imperceptibility is 1.49\%
   respectively.},
