@article{ WOS:000618933400005,
Author = {Driss, Maha and Ben Atitallah, Safa and Albalawi, Amal and Boulila,
   Wadii},
Title = {Req-WSComposer: a novel platform for requirements-driven composition of
   semantic web services},
