@inproceedings{ WOS:000462278900010,
Author = {Wang, Jin and Zhang, Min and Gan, Lin and Mo, Wenxiong and Wang, Hongbin
   and Qin, Yu and Luo, Simin},
Book-Group-Author = {IEEE},
Title = {Research and Application of Performance Verification Platform and
   Evaluation System for Partial Discharge Detector},
Booktitle = {2018 IEEE INTERNATIONAL CONFERENCE ON HIGH VOLTAGE ENGINEERING AND
   APPLICATION (ICHVE)},
Series = {International Conference on High Voltage Engineering and Application},
Year = {2018},
Note = {IEEE International Conference on High Voltage Engineering and
   Application (ICHVE), Athens, GREECE, SEP 10-13, 2018},
Organization = {IEEE; Natl Tech Univ Athens; IEEE Dielectr \& Elect Insulat Soc; Testing
   Res \& Stand Ctr; High Volt; Raycap; Protasis; CABLEL; Megger; AKTOR;
   Inst Engn \& Technol; SKT Testing; ADMIE SA},
Abstract = {With the rapid development of electrical equipment test technology,
   various types of partial discharge detector are widely used to detect
   the partial discharge status of electrical equipment in power sector.
   However, with the long-term use of partial discharge detector, the data
   accuracy acquired from the test device lacks effective verification,
   which greatly affects the operation personnel to formulate maintenance
   strategy. In view of this, based on the ultra-high frequency(UHF)
   partial discharge detection technology, this paper proposes a new
   calibration method about the combination of high simulation signal
   source and real type of defect and a new evaluation system. We also
   developed a performance verification platform of UHF partial discharge
   detector, which can verify the sensitivity, linearity error, range
   amplitude frequency response and other performance parameters of partial
   discharge measuring instrument. Finally, a total of 132 partial
   discharge detectors performance tests were completed by the test
   platform. The results show that 45 partial discharge detectors have
   defects and the defect rate is as high as 34\%. Therefore, performance
   verification platform of the partial discharge detector in this paper
   can find defects of partial discharge measuring instrument in advance,
   which is of great significance to enhance the power grid security.},
