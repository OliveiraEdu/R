@article{ WOS:001319325600003,
Author = {Dios, Marcelle Mourelle Perez and Rocha, Maria Gabryelle Dantas},
Title = {The storage and preservation of files related to digital bank credit
   notes: ensuring their reproducibility amidst software obsolescence},
