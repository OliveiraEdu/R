@article{ WOS:000972200700001,
Author = {Li, Yi and Shen, Jian and Ji, Sai and Lai, Ying-Hsun},
Title = {Blockchain-Based Data Integrity Verification Scheme in AIoT Cloud-Edge
   Computing Environment},
Journal = {IEEE TRANSACTIONS ON ENGINEERING MANAGEMENT},
Year = {2024},
Volume = {71},
Pages = {12556-12565},
Abstract = {With the rapid development of Artificial Intelligence of Things (AIoT)
   technology and applications, the cloud-edge computing system provides
   convenient and low-latency storage and decentralized computing services
   to reduce computing requirements in the cloud environment. However, data
   integrity verification is still an urgent issue researchers have widely
   discussed in AIoT cloud-edge computing environment. As a distributed and
   immutable ledger technology, blockchain provides an effective way of
   data verification in digital financial transactions. The research
   proposes a blockchain-based data integrity verification scheme to
   improve the data verification rate in cloud-edge computing environment.
   Based on the method, a detailed blockchain-based data integrity
   verification scheme without a trusted third party is proposed with a
   data upload phase and a data verification phase. The novel proposal
   system is built on Hyperledger Sawtooth and experimentally evaluated
   against two state-of-the-art systems in a simulated cloud-edge
   environment. The results demonstrate that the proposed scheme can
   efficiently verify data integrity with a high verification rate.},
