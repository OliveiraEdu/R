@article{ WOS:000843279600004,
Author = {Megala, G. and Swarnalatha, P.},
Title = {Efficient high-end video data privacy preservation with integrity
   verification in cloud storage},
Journal = {COMPUTERS \& ELECTRICAL ENGINEERING},
Year = {2022},
Volume = {102},
Month = {SEP},
Abstract = {Cloud data protection intends to secure data stored in the cloud.
   Security and integrity are still major concerns regarding the outsourced
   data to the cloud. This work focuses to preserve the privacy and
   integrity of videos stored in the cloud. A stream cipher suite involving
   key genera-tion, encryption, and authentication phases is designed. The
   Elliptic Curve Diffie Hellman approach is used to generate asymmetric
   keys. HECV compressed videos are fast processed by Apache Flink and are
   encrypted by XSalsa20 stream cipher. An ASCON-based SHA-3
   authenti-cation mechanism is proposed to generate an authentication code
   for the uploaded videos to guarantee tamper-proof. The proposed method
   scrambles the Spatio-temporal resolution of videos with better
   encryption time compared to the traditional approaches. Experimental
   result shows that the HEVC videos are authenticated and encrypted using
   the proposed cipher suite is fast, safe, and resists several forms of
   attacks resulting in improved information sensitivity and cost benefits.},
