@inproceedings{ WOS:001297807000027,
Author = {Ruiz de Veye, Ander and Emaldi, Mikel and Sainz, Nekane and Montanaro,
   Teodoro and Sergi, Ilaria and Patrono, Luigi},
Editor = {Solic, P and Nizetic, S and Rodrigues, JJPC and Perkovic, T and Catarinucci, L and Patrono, L and Gonzalez-De-Artaza, DLD},
Title = {Development of a web solution for academic competence certification and
   verification using blockchain},
Booktitle = {2024 9TH INTERNATIONAL CONFERENCE ON SMART AND SUSTAINABLE TECHNOLOGIES,
   SPLITECH 2024},
Year = {2024},
Note = {9th International Conference on Smart and Sustainable Technologies
   (SpliTech), Split, CROATIA, JUN 25-28, 2024},
Organization = {IEEE; IEEE Commun Soc; IEEE Council RFID},
Abstract = {The European Digital Credentials for Learning standard is a set of tools
   and software programs that allows academic institutions to create,
   store, verify, and share digital academic credentials. A digital
   academic credential allows any type of educational achievement to be
   accredited through digital means and with the same legal value as a
   physical credential, recognizing the issuer of the credential and the
   accredited person as well. Academic competences describe a set of
   skills, knowledge, and behaviours that a student acquires during the
   educational process and that can vary from one student to another. In
   this paper we present CertiDeusto, a web application for the management
   of digital credentials associated with the academic competences that
   each student obtains throughout the university educational process. This
   web application also complies with the EBSI standards in order to
