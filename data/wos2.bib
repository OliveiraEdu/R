Title = {Verification: Accuracy Evaluation of WiFi Fine Time Measurements on an
   Open Platform},
Booktitle = {MOBICOM'18: PROCEEDINGS OF THE 24TH ANNUAL INTERNATIONAL CONFERENCE ON
   MOBILE COMPUTING AND NETWORKING},
Year = {2018},
Pages = {417-427},
Note = {24th Annual International Conference on Mobile Computing and Networking
   (MobiCom), New Delhi, INDIA, OCT 29-NOV 02, 2018},
Organization = {Assoc Comp Machinery; Assoc Comp Machinery SIGMOBILE; NSF; Infosys;
   CISCO; Google; Microsoft},
Abstract = {Academic and industry research has argued for supporting WiFi
   time-of-flight measurements to improve WiFi localization. The IEEE
   802.11-2016 now includes a Fine Time Measurement (BIM) protocol for WiFi
   ranging, and several WiFi chipsets offer hardware support albeit without
   fully functional open software. This paper introduces an open platform
   for experimenting with fine time measurements and a general, repeatable,
   and accurate measurement framework for evaluating time-based ranging
   systems. We analyze the key factors and parameters that affect the
   ranging performance and revisit standard error correction techniques for
   WiFi time-based ranging system. The results confirm that meter-level
   ranging accuracy is possible as promised, but the measurements also show
   that this can only be consistently achieved in low-multipath
   environments such as open outdoor spaces or with denser access point
   deployments to enable ranging at or above 80 MHz bandwidth.},
