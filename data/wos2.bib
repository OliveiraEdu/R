@article{ WOS:001626709000003,
Author = {Dai, Jiao and Huang, He and Wang, Yufei and Duan, Li and Hu, Fuqiang and
   Yan, Dantong and Liu, Zhichen and Wang, Wei},
Title = {Byzantine-resistant model verification for decentralized federated
   learning in intelligent transportation systems},
Journal = {APPLIED SOFT COMPUTING},
Year = {2026},
Volume = {186},
Number = {D},
Month = {JAN},
Abstract = {Blockchain-enabled Federated Learning (FL) has been widely adopted in
   intelligent transportation systems to facilitate collaborative model
   training while preserving data privacy. Key devices, such as traffic
   signals and obstacle detection cameras, generate large volumes of image
   data, but privacy constraints hinder direct data sharing. FL inherently
   addresses the issue of sensitive data sharing by enabling collaborative
   training without the need to share raw data. Blockchain's
   decentralization and immutability provide auditability and secure data
   usage in FL settings. However, current blockchain-FL frameworks face
   three major challenges: (1) Malicious participants may upload poisoned
   models, deliberately disrupting the training of the global model; (2)
   Lazy participants may submit outdated or reused parameters, leading to
   degraded overall performance; (3) Existing reputation mechanisms fail to
   distinguish malicious intent from low-quality contributions, resulting
   in unfair rewards and poor model robustness. To enhance trust and
   accountability, blockchain is further integrated to provide
   verifiability and safeguard against malicious or lazy behavior. To
   address these issues, this work proposes a robust model verification
   method that integrates zero-knowledge proofs with a reputation
   mechanism. A dual-metric scheme combining accuracy and cosine similarity
   is used to detect malicious updates. Zero-knowledge proofs and hash
   storage allow verification of training without revealing private data,
   effectively identifying lazy participants. This method ensures that only
   legitimate model updates, derived from actual local training, are
   accepted. Based on verification outcomes, a blockchain-based reputation
   scheme penalizes dishonest behavior. Experiments on MNIST,
   Fashion-MNIST, and CIFAR-10 demonstrate that the proposed approach
   maintains model performance under attack and outperforms existing
   defenses.},
