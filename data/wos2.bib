   Dubois, Ludwig; Verhaegen, Frank, Maastricht Univ, Med Ctr, Dept Radiat Oncol MAASTRO, GROW Sch Oncol \& Dev Biol, Maastricht, Netherlands.},
DOI = {10.1259/bjr.20180455},
Article-Number = {20180455},
