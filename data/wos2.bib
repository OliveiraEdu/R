@article{ WOS:001541001700004,
Author = {Rehman, Saddiq Ur and Hwang, Kyung-Eun and Kim, Inhan},
Title = {Semantic-enriched framework for asynchronous bidirectional BIM data
   exchange with immersive visualization platform},
Journal = {AUTOMATION IN CONSTRUCTION},
Year = {2025},
Volume = {178},
Month = {OCT},
Abstract = {The construction industry increasingly leverages immersive visualization
   platforms to improve project comprehension. However, achieving seamless
   bidirectional data exchange with Building Information Modeling (BIM)
   tools remains a significant challenge. Traditional approaches support
   only one-way transfers with limited semantic metadata, resulting in
   significant manual effort and hindering iterative design. This paper
   introduces ReUniXchange, a framework that automates bidirectional,
   asynchronous data exchange between BIM tools and immersive visualization
   platforms, advancing automation in construction workflows. It
   automatically integrates 3D geometry and construction-specific metadata
   into immersive environments, captures user modifications, and reinserts
   updates into BIM models while preserving data structure and hierarchy.
   Evaluations through two distinct case studies demonstrate enhanced
   semantic data fidelity, improved process efficiency, reduced file sizes,
   and error elimination. ReUniXchange advances construction automation by
   enabling bidirectional, automated BIM data exchange with immersive
   platform, promoting seamless integration of design, analysis, and
   simulation processes for more efficient and data-driven project
   delivery.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
