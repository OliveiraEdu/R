@inproceedings{ WOS:001285455700008,
Author = {Shen, Lin and Wang, Yang and You, Lizhao and Li, Haihua and Song, Wei
   and Yao, Ziyang and Yuan, Zhou and Dong, Feng and Sun, Ronghua},
Book-Group-Author = {Assoc Computing Machinery},
Title = {A Lightweight and Fast Network Verification Platform for Cloud Data
   Center Networks},
Booktitle = {PROCEEDINGS OF THE 2024 SIGCOMM WORKSHOP ON FORMAL METHODS AIDED NETWORK
   OPERATION, FMANO 2024},
Year = {2024},
Pages = {20-26},
Note = {Workshop on Formal Methods Aided Network Operation (FMANO), Sydney,
   AUSTRALIA, AUG 04-08, 2024},
Organization = {SIGCOMM},
Abstract = {The massive-scale cloud data center networks (DCNs) are hard to operate
   and manage manually, and an automatic verification platform is required
   to reduce network outrage risks. The current configuration verification
   tools suffer from the low simulation performance when facing
   massive-scale BGP networks, and the low reachability analysis
   performance using specialized data structures. Leveraging the unique
   features of underlay DCNs that have a symmetric topology and the pure IP
   forwarding behavior, we present a new network verification platform, and
   address these challenges with the following two new components: (1) an
   ultra-fast BGP protocol simulator that uses topology compression,
   layered computation, and breadth-first search-based route propagation to
   accelerate BGP simulation; and (2) a lightweight and fast reachability
   analysis engine that uses the route propagation process and local
   forwarding check to realize reachability analysis. Evaluation results
   show that the BGP simulation can finish within 15 minutes for a cloud
   DCN with 10,000 nodes and 10 billion forwarding rules. We have deployed
   the new platform in verifying the running Huawei cloud DCNs, and
   identified several configuration errors. Some error cases are provided
   to the community for further study.},
