   O. V.},
Title = {Source Provenance and Paleogeographic Conditions during Deposition of
   Jurassic Continental Sediments in the Southern Part of the Siberian
   Platform (Implication of Sm-Nd and U-Pb Data)},
Journal = {DOKLADY EARTH SCIENCES},
Year = {2018},
Volume = {480},
Number = {2},
Pages = {720-724},
Month = {JUN},
Abstract = {The first Sm-Nd isotopic data and U-Pb (LA-ICP-MS) detrital zircon ages
   from sandstones of the Prisayan and Kuda Formations (the Irkutsk Basin,
   southern part of the Siberian Platform) have been obtained. They
   demonstrate that during accumulation of the sediments in the Irkutsk
   Basin, the contribution of local erosion sources decreased over time,
   while input from the Paleo-Transbaikalia sources increased. The change
   in provenance areas was triggered by tectonic rebuilding in
   Paleo-Transbaikalia caused by the closure of the Mongol-Okhotsk Ocean.},
