Book-Group-Author = {IEEE},
Title = {PREDICAT: A semantic service-oriented platform for data interoperability
   and linking in earth observation and disaster prediction},
Booktitle = {2018 IEEE 11TH CONFERENCE ON SERVICE-ORIENTED COMPUTING AND APPLICATIONS
   (SOCA)},
