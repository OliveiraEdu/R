@inproceedings{ WOS:001442271600007,
Author = {Melara, Marcela S. and Kimes, Chad},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Auditing the CI/CD Platform: Reproducible Builds vs. Hardware-Attested
   Build Environments, Which is Right for You?},
Booktitle = {PROCEEDINGS OF THE 2024 WORKSHOP ON SOFTWARE SUPPLY CHAIN OFFENSIVE
   RESEARCH AND ECOSYSTEM DEFENSES, SCORED 2024},
Year = {2024},
Pages = {43-44},
Note = {3rd Workshop on Software Supply Chain Offensive Research and Ecosystem
   Defenses, Salt Lake City, UT, OCT 14-18, 2024},
Abstract = {Recent software supply chain attacks, such as the SolarWinds hack and
   xz-utils backdoor, demonstrate the widespread impact of tampering with a
   package's build environment to subvert the final software product. To
   detect compromises in the systems and services that underlie the supply
   chain with higher confidence, software vendors today may choose between
   a few promising approaches: Reproducible Builds {[}4], or
   hardware-attested build environments, a proposed combination {[}2] of
   CNCF in-toto {[}6], OpenSSF Supply-chain Levels for Software Artifacts
   (SLSA) {[}3] and trusted hardware. At first glance, Reproducible Builds
   and hardware-attested build environments address the same challenge of
   auditing the build platform for tampering. The former establishes
   practices for achieving consistent build process results, making
   divergences detectable, while the latter captures verifiable evidence
   about properties of the compute environment that executed a build,
   making changes to that environment detectable. Yet, despite relying
   largely on existing techniques, neither approach has seen broad adoption
   by CI/CD platforms or enterprise software vendors {[}1, 7, 10]. To
   understand these trends, we seek to answer two central questions: (1)
   What security problems does each approach address? (2) What are the
   practical adoption requirements of each approach? In this
   security-in-practice talk, we examine the similarities and differences
   between Reproducible Builds and hardware-attested build environments,
   and discuss challenges of implementation in practice. We will address a
   very common question about the trade-offs between adopting only one or
   both approaches, and conclude with adoption recommendations for several
   types of software development settings.},
Publisher = {ASSOC COMPUTING MACHINERY},
Address = {1601 Broadway, 10th Floor, NEW YORK, NY, UNITED STATES},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Melara, MS (Corresponding Author), Intel Corp, Hillsboro, OR 97124 USA.
