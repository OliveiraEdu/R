Title = {Design and Development of a Provenance Capture Platform for Data Science},
Booktitle = {2024 IEEE 40TH INTERNATIONAL CONFERENCE ON DATA ENGINEERING WORKSHOP,
   ICDEW},
Series = {IEEE International Conference on Data Engineering Workshop},
Year = {2024},
Pages = {285-290},
Note = {40th International Conference on Data Engineering Workshop (ICDEW),
   Utrecht, NETHERLANDS, MAY 13-17, 2024},
Organization = {IEEE},
Abstract = {As machine learning and AI systems become more prevalent, understanding
   how their decisions are made is key to maintaining their trust. To solve
   this problem, it is widely accepted that fundamental support can be
   provided by the knowledge of how data are altered in the pre-processing
   phase, using data provenance to track such changes. This paper focuses
   on the design and development of a system for collecting and managing
   data provenance of data preparation pipelines in data science. An
   investigation of publicly available machine learning pipelines is
   conducted to identify the most important features required for the tool
   to achieve impact on a broad selection of preprocessing data
   manipulation. This reveals that the operations that are used in practice
   can be implemented by combining a rather limited set of basic operators.
   We then illustrate and test implementation choices aimed at supporting
   the provenance capture for those operations efficiently and with minimal
   effort for data scientists.},
