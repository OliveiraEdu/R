Title = {O'FAIRe: Ontology FAIRness Evaluator in the AgroPortal Semantic Resource
   Repository},
Booktitle = {SEMANTIC WEB: ESWC 2022 SATELLITE EVENTS},
Series = {Lecture Notes in Computer Science},
