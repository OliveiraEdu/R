@inproceedings{ WOS:000657112800123,
Author = {Yang, Chenxue and Sun, Zhiguo},
Editor = {Zaniolo, C and DiFatta, G and Cuzzocrea, A and Sheng, V and Wu, X},
Title = {Data Management System based on Blockchain Technology for Agricultural
   Supply Chain},
Booktitle = {20TH IEEE INTERNATIONAL CONFERENCE ON DATA MINING WORKSHOPS (ICDMW 2020)},
