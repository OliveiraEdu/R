Title = {Blockchain-Based Master Data Management in Supply Chains: A Design
   Science Study},
Booktitle = {ADVANCES IN PRODUCTION MANAGEMENT SYSTEMS: ARTIFICIAL INTELLIGENCE FOR
   SUSTAINABLE AND RESILIENT PRODUCTION SYSTEMS, APMS 2021, PT IV},
