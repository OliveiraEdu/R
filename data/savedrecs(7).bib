@inproceedings{ WOS:001506442400011,
Author = {Kumar, Amit and Yoshiuchi, Hideya},
Book-Group-Author = {IEEE},
Title = {Graph Similarity-Based Data Management Platform for Advancing Material
   Informatics},
Booktitle = {2024 9TH INTERNATIONAL CONFERENCE ON BIG DATA ANALYTICS, ICBDA 2024},
