@inproceedings{ WOS:000765039800002,
Author = {Asano, Yasuhito and Cao, Yang and Hidaka, Soichiro and Hu, Zhenjiang and
   Ishihara, Yasunori and Kato, Hiroyuki and Nakano, Keisuke and Onizuka,
   Makoto and Sasaki, Yuya and Shimizu, Toshiyuki and Takeichi, Masato and
   Xiao, Chuan and Yoshikawa, Masatoshi},
