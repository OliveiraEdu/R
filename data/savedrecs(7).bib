Title = {Towards Blockchain-Based Secure Data Management for Remote Patient
   Monitoring},
Booktitle = {2021 IEEE INTERNATIONAL CONFERENCE ON DIGITAL HEALTH (ICDH 2021)},
Year = {2021},
Pages = {299-308},
Note = {IEEE International Conference on Digital Health (ICDH) / IEEE World
   Congress on Services (SERVICES), ELECTR NETWORK, SEP 05-11, 2021},
Organization = {IEEE; IEEE Comp Soc},
Abstract = {Traditional data collection, storage and processing of Electronic Health
   Records (EHR) utilize centralized techniques that pose several risks of
   single point of failure and lean the systems to a number of internal and
   external data breaches that compromise their reliability and
   availability. Blockchain is an emerging distributed technology that can
   solve these issues due to its immutability and architectural nature that
   prevent records manipulation or alterations. In this paper, we discuss
   the progress and opportunities of remote patient monitoring using
   futuristic blockchain technologies and its two primary frameworks:
   Ethereum and Hyperledger Fabric. We also discuss the possible blockchain
   use cases in software engineering for systematic, disciplined, and
   quantifiable application development. The study extends by introducing a
   system architecture for EHR data management using Ethereum as a model.
   We discuss the challenges and limitations along with the initial
   evaluation results of the proposed system and draw future research
   directions in this promising area.},
