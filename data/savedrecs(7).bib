@article{ WOS:000820923200010,
Author = {Singh, Suruchi and Sharma, Satish Kumar and Mehrotra, Pavas and Bhatt,
   Pankaj and Kaurav, Monika},
Title = {Blockchain technology for efficient data management in healthcare
   system: Opportunity, challenges and future perspectives},
Journal = {MATERIALS TODAY-PROCEEDINGS},
Year = {2022},
Volume = {62},
Number = {7, SI},
Pages = {5042-5046},
Note = {1st International Conference on Innovative Technology for Sustainable
   Development (ICITSD), VIT, Chennai Campus, Sch Comp Sci \& Engn,
   Chennai, INDIA, JAN 27-29, 2021},
Abstract = {The healthcare data management system faces critical challenges related
   to data transparency, traceabil-ity, immutability, auditing, secure data
   provenance, and trust. This study aimed to provide a prospective
   overview of how blockchain technology can efficiently improve medical
   record management. Blockchain technology, an emerging and disruptive
   decentralized technology, is poised to impact the way data is handled in
   the healthcare industry significantly. As a result of this technology,
   we can fill out a patient's medical record efficiently and validated.
   Blockchain helps form a single network in which different orga-nizations
   can safely share their records by forming a chain by linking it
   privately to store records like radiographic or different images.
   Blockchain-based digital platforms allow patients to interact with their
   data providers, including healthcare providers, in a seamless, fast and
   simple way. Numerous open research challenges, which we identify and
   explore, are inhibiting the successful implementation of blockchain in
   the healthcare sector. In this chapter, we have discussed the way that
   Electronic Medical Records is managed by blockchain, and this novel
   technology can be used in creating an efficient as well as
   interoperation infrastructure that helps in maintaining the record of
   patients that deals in improving the healthcare outcomes at the same
   time it also maintains its integrity and privacy of the essential data.
   We also discuss both existing and recent developments of management data
   in healthcare based on the blockchain model. We highlight the primary
   benefits of implementing blockchain technology, as well as the potential
   for healthcare companies. We highlight a range of healthcare
   applications have been demonstrated using recent research and case
   studies. The present study identifies and explains several outstanding
   issues that slow the adoption of blockchain technology in health care.
   Finally, we propose many more research topics for discussion and
   investigation.Copyright (c) 2022 Elsevier Ltd. All rights reserved.
   Selection and peer-review under responsibility of the scientific
   committee of the International Confer-ence on Innovative Technology for
   Sustainable Development.},
