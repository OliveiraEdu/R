@article{ WOS:001665412600001,
Author = {Ahmed, Aqeel and Taj, Kamran and Hyder, Farhan},
Title = {A Blockchain-Driven Framework for Educational Document Verification in
   Pakistan},
Journal = {MEHRAN UNIVERSITY RESEARCH JOURNAL OF ENGINEERING AND TECHNOLOGY},
Year = {2026},
Volume = {45},
Number = {1},
Pages = {79-87},
Month = {JAN},
Abstract = {This research work provides a blockchain-based system for digital
   identification and authentication of educational documents in Pakistan.
   The suggested model is striving to eradicate the problems that occur
   continuously like document fraud, long process of manual verification,
   lack of clarity, and poor interchangeability between institutions. The
   system that uses Ethereum for smart contracts and IPFS for decentralized
   storage allows academic records to be accessed with security,
   unforgeability, and high efficiency. A simple and user-friendly
   prototype with a web-based interface was constructed which was for
   students, institutions, and recruiters. To check the usability, the USE
   questionnaire was used. 204 responses (152 students and 52 recruiters)
   were gathered. Student participant ages were from 18 to 35 years (81\%
   male, 19\% female), whereas recruiters were between 30 and 50 years
   (70\% male, 30\% female) as per demographic analysis. The evaluation
   exhibited dependability for the constructs tested, with Cronbach's alpha
   values of 0.805 for usefulness, 0.781 for ease of use, 0.809 for ease of
   learning, and 0.761 for satisfaction. Hypothesis testing identified
   three positive correlations: usability -> satisfaction (beta=0.228,
   p=0.001), ease of use -> satisfaction (beta=0.188, p=0.000), and ease of
   learning -> satisfaction (beta=0.285, p=0.000). Therefore, the system
   usability factors have a significant impact on overall user
   satisfaction, as evidenced by the results consistent with the acceptance
   of blockchain technology in educational document verification. The
   findings emphasize that the technology, in addition to lowering red
   tape, builds confidence with the users thereby facilitating the
   implementation of paperless processes which are of great environmental
   value. This research shows that the use of blockchain and decentralized
   storage can make the verification of educational documents in
   underprivileged areas more open, friendly to resources, and dependable,
   hence the possibility of expansion to the entire academic world.},
Publisher = {MEHRAN UNIV ENGINEERING \& TECHNOLOGY},
