@article{ WOS:000492422700010,
Author = {Han, Xuan and Yuan, Yong and Wang, Fei-Yue},
Title = {A Fair Blockchain Based on Proof of Credit},
Journal = {IEEE TRANSACTIONS ON COMPUTATIONAL SOCIAL SYSTEMS},
Year = {2019},
Volume = {6},
