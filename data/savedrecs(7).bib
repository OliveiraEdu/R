Author = {Rahoof, T. P. Abdul and Deepthi, V. R.},
Editor = {VanHung, D and DSouza, M},
Title = {HealthChain: A Secure Scalable Health Care Data Management System Using
   Blockchain},
Booktitle = {DISTRIBUTED COMPUTING AND INTERNET TECHNOLOGY (ICDCIT 2020)},
