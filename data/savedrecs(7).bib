@article{ WOS:001012875100025,
Author = {Xiao, Xiangli and Zhang, Yushu and Dong, Xuewen and Wang, Liangmin and
   Xiang, Yong and Cao, Xiaochun},
Title = {Fair Outsourcing Paid in Fiat Money Using Blockchain},
Journal = {IEEE TRANSACTIONS ON SERVICES COMPUTING},
