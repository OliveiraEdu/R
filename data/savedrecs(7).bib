Title = {A Blockchain-based Transaction Verification Infrastructure in Public
   Transportation},
Booktitle = {2024 19TH CONFERENCE ON COMPUTER SCIENCE AND INTELLIGENCE SYSTEMS,
   FEDCSIS 2024},
