@article{ WOS:001616076900004,
Author = {Zhu, Yiwei and Li, Dabo and Liu, Jianhua and Liu, Zilong and Xiong,
   Xingchuang},
Title = {Toward the NQI trusted scientific data space building an information
   integration and data sharing platform},
Journal = {MEASUREMENT},
Year = {2026},
Volume = {258},
Number = {E},
Month = {JAN 30},
Abstract = {Scientific data, as a critical foundational strategic resource, plays a
   dual role in advancing research and fostering innovation. Against the
   backdrop of global open science and open data initiatives, as well as
   China's policy of recognizing data as a factor of production, this study
   explores the establishment of a trusted scientific data space for the
   National Quality Infrastructure (NQI) domain. Specifically, it focuses
   on the development of an NQI information integration and data sharing
   platform (NQI IIDSP) led by the National Institute of Metrology, China
   (NIM). By integrating authoritative data sources, implementing
   multi-level access control, and standardizing workflows, the platform
   ensures trusted data governance, facilitates resource interaction, and
   promotes value cocreation. The platform has preliminarily established a
   NQI scientific research projects database and the corresponding output
   database, along with a robust scientific data archiving system (SDAS),
   laying a solid foundation for the construction of a NQI trusted
   scientific data space. In the future, efforts will focus on enhancing
   data resource quality, integrating AI-driven analytics, improving
   governance mechanisms, and establishing industry standards to support
   the development of a national integrated data market, ultimately
   accelerating innovation and digital transformation in the NQI domain.},
