@inproceedings{ WOS:001295199600012,
Author = {Liu, Yuxuan and Zhang, Jianxiong and Ding, Xuefeng and Guo, Bing and Hu,
   Dasha and Jiang, Yuming},
Editor = {Cao, C and Chen, H and Zhao, L and Arshad, J and Asyhari, T and Wang, Y},
Title = {Efficient Data Asset Right Provenance for Data Asset Trading Based on
   Blockchain},
Booktitle = {KNOWLEDGE SCIENCE, ENGINEERING AND MANAGEMENT, PT IV, KSEM 2024},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2024},
