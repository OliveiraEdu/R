@inproceedings{ WOS:000850975700012,
Author = {Marmsoler, Diego},
Editor = {Perez, JA and Yoshida, N},
Title = {Towards Verified Blockchain Architectures: A Case Study on Interactive
   Architecture Verification},
Booktitle = {FORMAL TECHNIQUES FOR DISTRIBUTED OBJECTS, COMPONENTS, AND SYSTEMS
   (FORTE 2019)},
Series = {Lecture Notes in Computer Science},
Year = {2019},
Volume = {11535},
Pages = {204-223},
Note = {39th IFIP WG 6.1 International Conference on Formal Techniques for
   Distributed Objects, Components, and Systems (FORTE) Held as Part of the
   14th International Federated Conference on Distributed Computing
   Techniques (DisCoTec), Lyngby, DENMARK, JUN 17-21, 2019},
Organization = {Int Federat Informat Proc Working Grp 6 1; Tech Univ Denmark, Dept Appl
   Math \& Comp Sci; Int Federat Informat Proc},
Abstract = {With the emergence of cryptocurrencies, Blockchain architectures have
   become more and more important. In such architectures, components
   maintain and exchange a list of records in a way which makes the entries
   persistent, i.e., resistant to modifications. Thereby, the architecture
   is dynamic in the sense that components may join or leave the network
   and connections between them may change over time. The dynamic nature of
   Blockchain architectures makes their verification a challenge, since it
   involves reasoning about potentially unbounded number of components. To
   this end, we developed FACTuM, an approach for the specification and
   interactive verification of dynamic architectures based on the
   interactive theorem prover Isabelle. In this paper we report on the
   outcome of applying the approach to formally specify a version of
   Blockchain architectures and verify that the list entries of such
   architectures are indeed persistent.},
