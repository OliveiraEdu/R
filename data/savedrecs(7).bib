Organization = {Int Assoc Comp Sci \& Informat Technol},
Abstract = {Coverage test technology is a common software testing technology, which
   is the basic requirement of software testing. The coverage analysis can
   quantify the completeness of the test vector. This paper introduces and
   compares two kinds of mainstream coverage analysis techniques, code
   coverage and functional coverage. On the basis of existing theories, the
   working principle of ONESPIN verification platform for
   VHDL/Verilog/System Verilog language coverage is studied in this paper
   and the specific testing procedures with a practical example are
   presented. At last, the covered code, uncovered code and the software
   defect in the test results are analyzed.},
