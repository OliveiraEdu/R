@inproceedings{ WOS:001575496300022,
Author = {Li, Xiaoming and Zhao, Yumei},
Book-Group-Author = {IEEE},
Title = {SecEvidence: Litigation Evidence Preservation and Verification on
   Blockchain with Secure Algorithms},
Booktitle = {2025 IEEE GLOBAL BLOCKCHAIN CONFERENCE, GBC},
Year = {2025},
Note = {2025 Global Blockchain Conference-GBC, Shanghai, PEOPLES R CHINA, JUN
   20-22, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {The exponential growth of the digital economy has led to electronic
   commerce, intellectual property rights, and electronic contracts
   becoming the primary business models for enterprises, which have also
   resulted in numerous disputes. Using electronic evidence for litigation
   has become an inevitable trend for courts. However, traditional
   electronic data faces inherent challenges such as susceptibility to
   tampering, fragility, and vulnerability to attacks. This undermines the
   credibility of electronic evidence stored on proprietary or cloud
   servers, necessitating technical solutions to ensure data integrity.
   Blockchain technology provides immutable and transparent features,
   making it a promising solution for ensuring data integrity. This paper
   proposes a secure litigation electronic evidence preservation and
   verification framework called SecEvidence, leveraging blockchain
   technology and cryptographic techniques. Our framework designs a robust
   litigation electronic evidence preservation and verification system,
   adopts alternative key algorithms to mitigate security risks, and
   conducts extensive experimental evaluations to validate the feasibility
   and performance of the system.},
