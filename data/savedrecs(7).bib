Title = {Organizing Decentralized Energy Data Using Semantic Approach},
Booktitle = {2021 PHOTONICS \& ELECTROMAGNETICS RESEARCH SYMPOSIUM (PIERS 2021)},
Year = {2021},
Pages = {2213-2216},
Note = {Photonics and Electromagnetics Research Symposium (PIERS), Hangzhou,
   PEOPLES R CHINA, NOV 21-25, 2021},
Organization = {IEEE; Zhejiang Univ, Electromagnet Acad; Coll Informat Sci \& Elect
   Engn; Zhejiang Key Lab Adv Microelectron Intelligent Syst \& Applicat;
   Zhejiang Univ, Univ Illinois Urbana Champaign Inst; Natl Engn Res Ctr
   Opt Instruments; Shanghai Ideaoptics Corp Ltd; IEEE Geoscience \& Remote
   Sensing Soc; IEEE Antennas \& Propagat Soc; IEEE Photon Soc;
   Electromagnet Acad},
Abstract = {With recent ICT technologies developed for smart energy systems, sensors
   are popularly used for metering energy consumption by devices in
   decentralized smart energy networks. Processing energy consumption data
   at decentralized level will help to facilitate the high-efficiency
   energy use. Many smart energy projects have published the data on the
   web for other scholars to perform reanalysis on the data. However, such
   data tend to vary in storage format (e.g., CSV, JSON, XML) and focus
   more on the energy aspects. Moreover, adding information from outside
   data sources into the system such as weather is challenging because data
   of different sources are usually heterogeneous and exist as fragments on
   the web. In this paper, we propose using semantic approach to manage the
   decentralized energy data. The main advantage of this work is that it
   builds a well-defined interoperable structure for organizing the energy
   data. Furthermore, a variety of cross-domain data sources can be
   integrated naturally by human words to enhance the reanalysis on the
   decentralized energy data.},
