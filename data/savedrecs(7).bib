Title = {A Novel Blockchain-based Education Records Verification Solution},
Booktitle = {SIGITE'18: PROCEEDINGS OF THE 19TH ANNUAL SIG CONFERENCE ON INFORMATION
   TECHNOLOGY EDUCATION},
Year = {2018},
Pages = {178-183},
Note = {19th Annual SIG Conference on Information Technology Education (SIGITE),
   Fort Lauderdale, FL, OCT 03-06, 2018},
Organization = {ACM SIGITE; Assoc Comp Machinery},
Abstract = {This paper proposes a novel blockchain-based technique for creating an
   environment where individuals can be the custodians of their official
   education records and can easily share those records with others. A
   blockchain is a digitized, decentralized, open record of all
   cryptographic data exchanges. One key characteristic of the blockchain
   is its decentralized nature. Unlike records or accounts maintained by
   department, college, university, government agencies and other
   institutions, the blockchain does not require an intermediary to
   complete education records or alter records. Our solution incorporating
   the advanced features of blockchain allows education providers to issue
   official certificates that supply proof of completion or achievement.
   The proposed framework could also provide the corresponding functions
   for the after-college education and many other further usages.},
