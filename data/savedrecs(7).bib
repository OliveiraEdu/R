@incollection{ WOS:001605990700005,
Author = {Herman, Laura},
Editor = {Arora, P and Raman, U and Konig, R},
Title = {Globalized Creative Economies: Rethinking Local Craft, Provenance, and
   Platform Design},
Booktitle = {FEMINIST FUTURES OF WORK: Reimagining Labour in the Digital Economy},
Series = {Digital Studies},
Year = {2025},
Pages = {53-60},
Abstract = {In this chapter, I examine algorithmic platforms' misinterpretation of
   handmade creative wares that are constructed in the Global South. This
   serves as an example of Western creative platforms' misinterpretation of
   local cultural norms. As demonstrated by artisans that are selling both
   mass-produced and handmade objects, for instance, I argue that Western
   platforms must reconsider their traditional models of the creative
   economy. As the primary sites that serve to platform creative wares for
   a global consumer base, I call on these technology-enabled services to
   carefully consider the types of creativity that they uplift. Without
   such considerations, Western technology platforms impose their own
   assumptions about creativity on a global user base, thereby inhibiting
   local cultures' creative norms.},
