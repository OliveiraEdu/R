   Chernushevych, Valentyn},
Editor = {Morozov, A and Kazymyr, V and Palagin, A and Shkarlet, S and Stoianov, N and Vinnikov, D and Zheleznyak, M},
Title = {Implementing Recursive Proofs for Efficient Blockchain Verification: A
   zk-SNARKs Approach},
Booktitle = {MATHEMATICAL MODELING AND SIMULATION OF SYSTEMS, MODS 2023},
