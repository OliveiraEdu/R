@inproceedings{ WOS:001476916400003,
Author = {Daoulas, Christos and Sacharidis, Dimitris},
Editor = {Andris, C and Bouros, P and Kanza, Y and Renz, M and Sacharidis, D},
Title = {A FAIR Public Permissioned Blockchain System for monitoring
   Deforestation in the Amazon},
Booktitle = {PROCEEDINGS OF THE 8TH ACM SIGSPATIAL INTERNATIONAL WORKSHOP ON
   LOCATION-BASED RECOMMENDATIONS, GEOSOCIAL NETWORKS AND GEOADVERTISING,
   LOCALREC 2024},
