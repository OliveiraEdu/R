@inproceedings{ WOS:001539972000140,
Author = {Liu, Yukun and Zhang, Zheng and Zhang, Junxing},
Editor = {Abel, MH and Shen, W and Matta, N and Barthes, JP and Luo, J and Zhang, J and Zhu, H and Peng, K},
Title = {A Sensitive Data Management System Based on Blockchain and
   Semi-Converged Ring Network},
Booktitle = {2025 28TH INTERNATIONAL CONFERENCE ON COMPUTER SUPPORTED COOPERATIVE
   WORK IN DESIGN, CSCWD},
Series = {International Conference on Computer Supported Cooperative Work in
   Design},
Year = {2025},
Pages = {848-853},
Note = {28th International Conference on Computer Supported Cooperative Work in
   Design-CSCWD-Annual, Compiegne, FRANCE, MAY 05-07, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {In domains with stringent requirements for data consistency,
   immutability, and efficient access-such as healthcare, finance, and
   disciplinary inspection-existing sensitive data management systems face
   considerable challenges in supporting large-scale file storage and rapid
   multi-node access. To address these limitations, we propose a semi-
   converged ring network architecture combining IPFS. and Geth. This
   architecture evaluates and compares the performance of three network
   topologies, emphasizing the efficiency of node discovery and data
   consistency in the semi-integrated ring configuration By incorporating
   SQL-based querying capabilities, the proposed design ensures consistent
   data access across distributed locations and facilitates large file
   transfers. Experimental results confirm that the solution significantly
   enhances node discovery, data consistency, query performance, and system
   security.},
