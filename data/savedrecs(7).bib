Title = {Blockchain-Enhanced IoHT: A Patient-Centric Internet of Healthcare
   Things Platform with Smart Contract-Driven Data Management},
Booktitle = {ADVANCES IN MOBILE COMPUTING AND MULTIMEDIA INTELLIGENCE, MOMM 2023},
Series = {Lecture Notes in Computer Science},
Year = {2023},
Volume = {14417},
