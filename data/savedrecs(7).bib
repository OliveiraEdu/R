@article{ WOS:001420402100001,
Author = {Viswanathan, Balasubramanian and Lakshmi, B.},
Title = {Enhancing Educational Certificate Management and Verification with
   Blockchain Technology},
Journal = {JOURNAL OF COMPUTER INFORMATION SYSTEMS},
Year = {2025},
Month = {2025 FEB 14},
Abstract = {The difficulties with existing certificate verification systems are
   often expensive, time-consuming, and vulnerable to fraud addressed in
   this study. The professional and academic credentials are significant
   proof of a person's qualifications, but its centralized design of
   existing systems enables the data manipulation feasible and affects the
   security. The proposed method producing and ensuring the digital
   academic credentials utilizes the permissioned Ethereum blockchain
   platform to provide a decentralized, secured, and impenetrable system.
   Blockchain technology ensures certificate integrity and authenticity by
   eliminating a central authority. Employers and stakeholders can securely
   evaluate university credentials through a decentralized web application.
   This system eliminates verification delays and fraud, making certificate
   management more effective and efficient. Additionally, other certificate
   types include a pertaining to ownership or identity that added to the
   system. Overall, the proposed blockchain-based method improves the speed
   and dependability of credential verification procedures by offers a
   scalable and safe substitute for conventional certificate verification
   methods.},
