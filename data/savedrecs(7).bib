Title = {System for Verification Using Blockchain: Demonstration of PAN Cards,
   and College Transcripts Verification},
Booktitle = {PROCEEDINGS OF SECOND INTERNATIONAL CONFERENCE ON SUSTAINABLE EXPERT
   SYSTEMS (ICSES 2021)},
Series = {Lecture Notes in Networks and Systems},
Year = {2022},
Volume = {351},
Pages = {485-498},
Note = {2nd International Conference on Sustainable Expert Systems (ICSES),
   NEPAL, SEP 17-18, 2021},
Organization = {Tribhuvan Univ},
Abstract = {Verification is one of the most important factors of security and trust
   in this modern society, whether it is verification of college transcript
   for admissions, PAN cards for banks, Aadhar cards for voting, etc.
   Today's online verification processes are complicated and prone to
   cybersecurity attacks like data tampering and server hacking, and due to
   all these issues, trust between two entities can be compromised during
   the verification process. In this paper, we propose a new Blockchain-
   based architecture for the verification of the data in cyberspace.
   Blockchain technology is a modern disrupting technology that can be used
   to solve this issue. We also demonstrate a prototype of the system for
   the Indian PAN Card and college transcript.},
