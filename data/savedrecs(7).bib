@article{ WOS:000538424600023,
Author = {Kong, Xiangyue and Zhang, Jiyuan and Wang, Hao and Shu, Jie},
Title = {Framework of Decentralized Multi-chain Data Management for Power Systems},
Journal = {CSEE JOURNAL OF POWER AND ENERGY SYSTEMS},
Year = {2020},
Volume = {6},
Number = {2},
Pages = {458-468},
Month = {JUN},
Abstract = {With the wide application of advanced information and communication
   technology (ICT), power systems are becoming more reliable, more
   efficient and self-healing. Meanwhile more sophisticated cyber-attacks
   have appeared, e.g. false data injection (FDI) attacks, which deeply
   affect the state estimation of power systems and can lead to destructive
   consequences. To better manage and protect measurement data in power
   systems, we propose a blockchain-based multi-chain framework, taking
   advantage of the existing infrastructure. In this framework,
   measurements from sensors are mined into blocks by base stations using
   Practical Byzantine Fault Tolerance (PBFT) as the consensus protocol. We
   analyze the security of the proposed framework and carry out simulations
   to show its superiority compared to existing systems. The result of the
   simulations further provides guidance for how to structure the
   networking in the proposed framework.},
