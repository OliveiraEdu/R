@inproceedings{ WOS:000502622000001,
Author = {Aebeloe, Christian and Montoya, Gabriela and Hose, Katja},
Editor = {Hitzler, P and Fernandez, M and Janowicz, K and Zaveri, A and Gray, AJG and Lopez, V and Haller, A and Hammar, K},
Title = {A Decentralized Architecture for Sharing and Querying Semantic Data},
Booktitle = {SEMANTIC WEB, ESWC 2019},
Series = {Lecture Notes in Computer Science},
Year = {2019},
Volume = {11503},
Pages = {3-18},
Note = {16th International Extended Semantic Web Conference (ESWC), Portoroz,
   SLOVENIA, JUN 02-06, 2019},
Organization = {STI Int; Jozef Stefan Inst; QualiChain; Springer; Univ Innsbruck, STI
   Innsbruck; Elsevier; IBM Res; Siemens AG; Ontotext; MDPI, Informat
   Journal; Metaphacts; Onlim; Semant Web Co},
Abstract = {Although the Semantic Web in principle provides access to a vast Web of
   interlinked data, the full potential remains mostly unexploited. One of
   the main reasons for this is the fact that the architecture of the
   current Web of Data relies on a set of servers providing access to the
   data. These servers represent bottlenecks and single points of failure
   that result in instability and unavailability of data at certain points
   in time. In this paper, we therefore propose a decentralized
   architecture (Piqnic) for sharing and querying semantic data. By
   combining both client and server functionality at each participating
   node, and introducing replication, Piqnic avoids bottlenecks and keeps
   datasets available and queryable although the original source might not
   be available. Our experimental results, using a standard benchmark of
   real datasets, show that Piqnic can serve as an architecture for sharing
   and querying semantic data, even in the presence of node failures.},
