@article{ WOS:000941221200001,
Author = {Hiwale, Madhuri and Varadarajan, Vijayakumar and Walambe, Rahee and
   Kotecha, Ketan},
Title = {NikshayChain: A Blockchain-Based Proposal for Tuberculosis Data
   Management in India},
