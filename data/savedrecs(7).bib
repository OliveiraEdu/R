Author = {Wang Hongyu and Sheng Liming and Tang Xiaolei and Li Wenqiang and Jun,
   Shen and Jun, Tao},
Editor = {Li, J and Luo, C and Al-Turjman, F},
Title = {PCRAM-based data management method for storage and computation
   integration},
Booktitle = {2021 IEEE 9TH INTERNATIONAL CONFERENCE ON SMART CITY AND INFORMATIZATION
   (ISCI 2021)},
Year = {2021},
Pages = {1-7},
Note = {9th IEEE International Conference on Smart City and Informatization
   (iSCI) / 15th IEEE International Conference on Big Data Science and
   Engineering (BigDataSE), Shenyang Aerosp Univ, Shenyang, PEOPLES R
   CHINA, OCT 18-22, 2021},
Organization = {IEEE; IEEE Comp Soc},
Abstract = {The emergence of new storage media technologies speeds up IoT terminal
   improvement. In this paper, an IoT terminal PCRAM-based storage and
   computation integrated data management method is proposed. The method
   not only adopts a storage and computation integrated variable index
   scheme as cornerstone for hybrid memory management, but also expands the
   traditional FAT file system to achieve management of the storage and
   computation integrated variables in a file system. Testing results of
   our prototype implementation show that the performance of the method
   improves the performance of IoT terminal significantly. Power
   consumption can be improved more than 20\% by using the hybrid memory
   management of the proposed method in typical application scenario. Data
   throughput by using new file data access interfaces(sc\_store()/sc\_
   load()) within the method are also extremely enhanced: in contrast to
   traditional file wirte()/read() interface function, the performance of
   50KB (and above) file data write improved 140 times and the performance
   of file data read is improved more than 6 times.},
