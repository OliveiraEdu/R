@inproceedings{ WOS:001668836200013,
Author = {Subedi, Shistata},
Book-Group-Author = {ACM},
Title = {A Lightweight Historical Verification Layer for Decentralized Systems},
Booktitle = {PROCEEDINGS OF THE 2025 INTERNATIONAL MIDDLEWARE CONFERENCE DEMOS
   POSTERS AND DOCTORAL SYMPOSIUM TRACK},
Year = {2025},
Pages = {37-38},
Note = {26th International Middleware Conference-MIDDLEWARE, Nashville, TN, DEC
   15-19, 2025},
Abstract = {Decentralized systems, such as blockchains, have an auditable history
   that anyone can verify, yet most users still rely on centralized
   services such as Etherscan or Alchemy when checking historical account
   balances or contract states. Rebuilding proofs for historical queries by
   replaying the state is slow, while storing per-block proofs is too large
   for ordinary nodes.
   In this paper, we present a lightweight historical verification layer
   for decentralized state. It represents each block's state using a
   univariate commitment scheme and links these commitments across blocks,
   allowing clients to verify both point and range queries without
   reconstructing old Merkle structures. Our initial evaluation shows the
   cost of generating Merkle proofs on demand in existing systems and
   motivates the need for a more efficient historical verification layer.},
