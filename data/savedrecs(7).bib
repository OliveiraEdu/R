Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Hasegawa, Y (Corresponding Author), Ritsumeikan Univ, Grad Sch Informat Sci \& Engn, 1-1-1 Noji Higashi, Kusatsu, Shiga 5258577, Japan.
