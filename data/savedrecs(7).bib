@inproceedings{ WOS:001596492800001,
Author = {Colom, Miguel and Hernandez, Jose Armando and Kerautret, Bertrand and
   Perret, Benjamin},
Editor = {Colom, M and Krahenbuhl, A and Kerautret, B and Lopresti, D and Monasse, P and Perret, B},
Title = {Development Efforts for Reproducible Research: Platform, Library and
   Editorial Investment},
Booktitle = {REPRODUCIBLE RESEARCH IN PATTERN RECOGNITION, RRPR 2022},
Series = {Lecture Notes in Computer Science},
Year = {2023},
Volume = {14068},
Pages = {3-21},
Note = {2022 International Workshop on Reproducible Research in Pattern
   Recognition-RRPR, Montreal, CANADA, AUG 21, 2022},
Abstract = {Reproducible research in pattern recognition can be viewed from a number
   of angles, including code execution, platforms that promote
   reproducibility, code sharing, or the release of libraries providing
   access to relevant algorithms in the corresponding disciplines. In this
   work, after recalling the motivation and classic definitions of
   reproducible research, we propose an updated overview of the main
   platforms that might be used for reproducible research. We then review
