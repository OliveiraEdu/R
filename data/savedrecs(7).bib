@inproceedings{ WOS:001576480800024,
Author = {Zhang, Yubo and Botelho, Pedro and Gordon, Trevor and Zussman, Gil and
   Kadota, Igor},
Book-Group-Author = {IEEE},
Title = {Fair Dynamic Spectrum Access via Fully Decentralized Multi-Agent
   Reinforcement Learning},
Booktitle = {2025 23RD INTERNATIONAL SYMPOSIUM ON MODELING AND OPTIMIZATION IN
   MOBILE, AD HOC, AND WIRELESS NETWORKS, WIOPT},
Series = {International Symposium on Modeling and Optimization in Mobile Ad Hoc
   and Wireless Networks},
Year = {2025},
Pages = {174-181},
Note = {23rd International Symposium on Modeling and Optimization in Mobile, Ad
   Hoc, and Wireless Networks-WiOpt, Linkoeping, SWEDEN, MAY 26-29, 2025},
Organization = {Korea University},
Abstract = {We consider a decentralized wireless network with several
   source-destination pairs sharing a limited number of orthogonal
   frequency bands. Sources learn to adapt their transmissions
   (specifically, their band selection strategy) over time, in a
   decentralized manner, without sharing information with each other.
   Sources can only observe the outcome of their own transmissions (i.e.,
   success or collision), having no prior knowledge of the network size or
   of the transmission strategy of other sources. The goal of each source
   is to maximize their own throughput while striving for network-wide
   fairness. We propose a novel fully decentralized Reinforcement Learning
   (RL)-based solution that achieves fairness without coordination. The
   proposed Fair Share RL (FSRL) solution combines: (i) state augmentation
   with a semi-adaptive time reference; (ii) an architecture that leverages
   risk control and time difference likelihood; and (iii) a fairnessdriven
   reward structure. We evaluate FSRL in several network settings.
   Simulation results suggest that, when we compare FSRL with a common
   baseline RL algorithm from the literature, FSRL can be up to 89.0\%
   fairer (as measured by Jain's fairness index) in stringent settings with
   several sources and a single frequency band, and 48.1\% fairer on
   average.},
