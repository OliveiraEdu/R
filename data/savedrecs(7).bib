Pages = {339-343},
Note = {21st International Conference on Information Integration and Web-Based
   Applications and Services (iiWAS), Munich, GERMANY, DEC 02-04, 2019},
Organization = {Assoc Comp Machinery},
Abstract = {Solutions based on distributed ledgers require sophisticated tools for
   data modelling and integration that can be overcome using semantic and
   Linked Data technologies. One example is copyright management, where we
   attempt to adapt the Copyright Ontology so it can be used to build
   applications that benefit from both worlds, rich information modelling
   and reasoning together with immutable and accountable information
   storage that provides trust and confidence on the modelled rights
   statements. This approach has been applied in the context of an
   application for the management of social media re-use for journalistic
   purposes.},
