Title = {Decentralized Industrial IoT Data Management Based on Blockchain and
   IPFS},
Booktitle = {ADVANCES IN PRODUCTION MANAGEMENT SYSTEMS: TOWARDS SMART AND DIGITAL
   MANUFACTURING, PT II},
