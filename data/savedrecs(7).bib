Year = {2020},
Pages = {167-171},
Note = {29th World Wide Web Conference (WWW), Taipei, TAIWAN, APR 20-24, 2020},
Organization = {Assoc Comp Machinery; Quanta Comp; Taiwan Mobile Co Ltd; Chunghwa
   Telecom; Microsoft; Taipei City Govt, Dept Informat Technol; Zoom; FET;
   Web4Good; ELTA HD; ELTA Technol Co Ltd; Facebook; Yahoo Res; Pinterest},
Abstract = {With the growing popularity of Semantic Web technologies, more and more
   organizations natively manage data using Semantic Web standards, in
   particular RDF. This development gives rise to new requirements for
   Business Intelligence tools to enable analyses in the style of On-Line
   Analytical Processing (OLAP) over RDF data. In this demonstration, we
   therefore present the SETLBI (Semantic Extract-Transform-Load and
   Business Intelligence) integration platform that brings together the
   Semantic Web and Business Intelligence technologies. SETLBI covers all
   phases of integration: target definition, source to target mappings
   generation, semantic and non-semantic source extraction, data
   transformation, and target population and update. It facilitates Data
   Warehouse designers to build a semantic Data Warehouse, either from
   scratch or by defining a multi-dimensional view over existing RDF data
   sources, and further enables OLAP-style analyses.},
