@article{ WOS:001569002300005,
Author = {Kumar, Rahul and Bera, Chinmay and Kumar, Amitesh},
Title = {Experimental verification and analysis of a novel HMRFO-AAA heuristic
   method utilizing Z-source DC/DC converter using HIL for DC-microgrid
   connected intelligent PV-hybrid energy storage systems},
Journal = {JOURNAL OF ENERGY STORAGE},
Year = {2025},
Volume = {135},
Month = {NOV 1},
Abstract = {The present study discusses and experimentally verifies the enhanced
   power management performance of hybrid energy storage systems (HESS) by
   proposing a resilient design technique for stabilizing the DC bus
   voltage, with a focus on power management among renewable photovoltaic
   sources, batteries, and supercapacitors. This study proposes the use of
   a proportional-integral (PI) controller, optimized using novel hybrid
   manta ray foraging optimization-artificial algae algorithm (HMRFO-AAA)
   for the power management strategy (PMS) in a solar system with HESS. The
   controller is more robust with novel HMRFO-AAA tuning approaches
   compared to conventional bacterial foraging optimization (BFO) and manta
   ray foraging optimization (MRFO) based controllers. The strategy
   utilizes a Z-source DC-to-DC converter to enhance the PV voltage and
   extract the optimal amount of power from the photovoltaic array. Under
   various real-world data of load and input situations, including
   temperature and radiation level variations, the HMRFO-AAA-based PI
   controller effectively and efficiently regulates power distribution and
   stabilizes the DC bus voltage. With those improvements, HESS can now be
   reliably controlled, making it an appropriate choice for DC microgrid
   structures. Moreover, the proposed method's performance is demonstrated
   by reducing the settling time to 2.410 ms, despite variations in load
   and generation. Hardware-in-loop real-time simulations utilizing the
   OPAL-RT simulator illustrate the feasibility of implementing hybrid
   energy storage systems with a proposed control method based on a novel
   HMRFO-AAA heuristic approach.},
