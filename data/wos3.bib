@inproceedings{ WOS:000539283200006,
Author = {Redrovan-Reyes, E. and Chalco-Bermeo, J. and Robles-Bykbaev, V. and
   Carrera-Hidalgo, P. and Contreras-Alvarado, C. and Leon-Pesantez, A. and
   Nivelo-Naula, D. and Olivo-Deleg, J.},
Editor = {Rodriguez, DB},
Title = {An educational platform based on expert systems, speech recognition, and
   ludic activities to support the lexical and semantic development in
   children from 2 to 3 years},
Booktitle = {2019 IEEE COLOMBIAN CONFERENCE ON COMMUNICATIONS AND COMPUTING (COLCOM
   2019)},
