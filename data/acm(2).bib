abstract = {The influence mechanism of users' continuous use behavior of mobile health platforms is explored in this study. 507 samples were analyzed via Smart-PLS 4.0, the results indicated that performance expectancy, system quality, and effort expectancy significantly could affect the perceived usefulness and ease of use of mobile health platforms. These perceptions enhance user satisfaction, which directly drives continuous use behavior. Key suggestions include optimizing interface design, streamlining operations, and strengthening system stability, privacy protections to improve satisfaction and continuous use behavior.},
booktitle = {Proceedings of the 2025 2nd International Conference on Digital Society and Artificial Intelligence},
pages = {58–62},
numpages = {5},
keywords = {Continuous Use Behavior, Expectation Confirmation Model, M-Health, Technology Acceptance Model, User Satisfaction},
location = {
},
series = {DSAI '25}
}

@inproceedings{10.1145/2362499.2362531,
author = {Chen, Tao and Zhang, Yongjuan and Zhang, Shen and Chen, Chengcai and Chen, Heng},
title = {Building semantic information search platform with extended Sesame framework},
year = {2012},
isbn = {9781450311120},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/2362499.2362531},
doi = {10.1145/2362499.2362531},
abstract = {Semantic Web provides a common framework that allows data to be shared and reused across application, enterprise, and community boundaries. Therefore, this technology can be used to integrate disparate libraries resources in the field of library located in lots of different web sites. Based on Sesame framework, this article aims at building an extended platform which not only be used to convert web pages to RDF, but also provide a common interface to query semantic data among multiple data repositories. System architecture of the extended application is presented firstly, and how to define data and clue extraction rules for collected data from web pages with tools are introduced subsequently. Convert web data to the uniform RDF triple format data is another key point discussed in this paper. How to merge multi-core Solr and SIREn with Sesame system is also an important problem to be solved. Finally, a simple case is also given to prove the solution proposed in this paper. How to publish the linked data of this paper on the web is the advanced task which will be performed in the near future.},
booktitle = {Proceedings of the 8th International Conference on Semantic Systems},
pages = {193–196},
numpages = {4},
keywords = {RDF, SIREn, Sesame, Solr, ontology, semantic web},
location = {Graz, Austria},
series = {I-SEMANTICS '12}
}

@article{10.1145/1328690.1328715,
author = {Gulati, Ajay and Varman, Peter and Merchant, Arif and Uysal, Mustafa},
title = {Towards fairness and efficiency in storage systems},
year = {2007},
issue_date = {December 2007},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {35},
number = {3},
issn = {0163-5999},
url = {https://doi.org/10.1145/1328690.1328715},
doi = {10.1145/1328690.1328715},
abstract = {Fairness and overall I/O efficiency are two opposing forces when it comes to sharing I/O among different applications. Although providing QoS guarantees for applications sharing a storage server are desirable under many scenarios, existing work has not been able to make a convincing case for using fairness mechanisms for disk scheduling, mainly due to their impact on overall throughout. In this work, we plan to investigate two major issues: (1) study the trade-off between fairness and efficiency, and develop mechanisms to improve the I/O efficiency of fair schedulers (2) provide performance guarantees to applications in terms of higher-level application metrics (such as transactions/sec), by changing the parameters in a fairness algorithm that affect the allocations at the block level.},
journal = {SIGMETRICS Perform. Eval. Rev.},
month = dec,
pages = {56–58},
numpages = {3}
}

@inproceedings{10.1145/2539150.2539255,
author = {Costa, Felipe and Dantas, Carlos and Sorrentino, Tatiana and Ribeiro, Claudia},
title = {A Semantic Service-Oriented Platform for Integrated and Personalised Access to Sustainable Projects},
