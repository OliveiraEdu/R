booktitle = {Proceedings of the 6th ACM/IEEE-CS Joint Conference on Digital Libraries},
pages = {272–273},
numpages = {2},
keywords = {MARCXML, data mapping, metadata standards},
location = {Chapel Hill, NC, USA},
series = {JCDL '06}
}

@inproceedings{10.1145/303008.303029,
