author = {Besser, Howard},
title = {The making of America II: structural and administrative metadata standards for distributed repositories},
year = {1999},
isbn = {1581131453},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/313238.313328},
