doi = {10.1145/2539150.2539255},
abstract = {This paper reports the achieved results of a project that aims the development of a technological apparatus to support a sustainable development agenda. The resultant platform named ARIDUS concentrates specific services, such as capture and representation of knowledge behind sustainable projects. Initially addressed to the Brazilian Semiarid, ARIDUS can be used in different contexts thanks its key features such as service-oriented principles and semantic technologies.},
