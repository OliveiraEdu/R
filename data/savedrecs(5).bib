Editor = {Huang, DS and Premaratne, P and Jin, B and Qu, B and Jo, KH and Hussain, A},
Title = {CL-BOSIC: A Distributed Agent-Oriented Scheme for Remote Data Integrity
   Check and Forensics in Public Cloud},
Booktitle = {ADVANCED INTELLIGENT COMPUTING TECHNOLOGY AND APPLICATIONS, ICIC 2023,
   PT I},
Series = {Lecture Notes in Computer Science},
Year = {2023},
Volume = {14086},
