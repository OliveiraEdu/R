@article{ WOS:000766987500003,
Author = {Fu, Meng-Hsuan and Lee, An-Shyang},
Title = {Ballot Blockchain System Design and Development on Ethereum Platform},
Journal = {INTERNATIONAL JOURNAL OF SYSTEM DYNAMICS APPLICATIONS},
Year = {2022},
Volume = {11},
Number = {3},
Abstract = {Ballots are often held for fair decisions such as party theme selecting;
   however, the existing traditional ballots have some problems involving
   amount of human resources, cost of places, equipment, time and traffic,
   and repeated procedures. In order to solve the aforementioned issues, a
   ballot blockchain system is designed and implemented based on the smart
   contract of Ethereum. It is designed on the core blockchain technologies
   of the decentralized ledger technology, using a secure hash algorithm,
   anonymous user, incorruptible data, and adopting a public blockchain.
   The ballot blockchain system is implemented based on the MetaMask
   verification and the Remix interface development environment. The smart
   contract plays the role of the decision maker for controlling ballot
   activities instead of numerous human tasks. All ballot transactions are
   recorded in the ballot blockchain permanently when the ballot is
   completed. The aim of the ballot blockchain system is to achieve a fair,
   less time-consuming, secured, and transparent environment.},
