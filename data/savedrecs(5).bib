@article{ WOS:000880654600097,
Author = {Li, Ta and Tian, Youliang and Xiong, Jinbo and Bhuiyan, Md Zakirul Alam},
Title = {FVP-EOC: Fair, Verifiable, and Privacy-Preserving Edge Outsourcing
   Computing in 5G-Enabled IIoT},
Journal = {IEEE TRANSACTIONS ON INDUSTRIAL INFORMATICS},
Year = {2023},
Volume = {19},
Number = {1},
Pages = {940-950},
Month = {JAN},
Abstract = {The 5G-enabled Industrial Internet of Things tilts the data processing
   model from the cloud to the edge. Users are more inclined to get
   feedback and data analysis of outsourcing computing results timely from
   the edge. However, the existing solutions undermine the fairness of
   multitask outsourcing in edge environment and cannot guarantee the
   correctness of results. To tackle these challenges, in this article, we
   propose a fair, verifiable, and privacy-preserving edge outsourcing
   computing scheme based on blockchain (FVP-EOC). Initially, we propose a
   task bidding method in the same round of task outsourcing, which
   improves the utilization of resources and the fairness of the FVP-EOC by
   dividing tasks into blocks. Furthermore, we design a result verification
   algorithm and a consensus algorithm to ensure the correctness of the
   results without a trusted third party. Finally, theoretical analysis and
   ample simulations indicate that the FVP-EOC is secure and verifiable and
   ensure the benefits of all the participants in edge outsourcing
   computing.},
